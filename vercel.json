{
  "version": 2,
  "builds": [
    {
      "src": "admin-panel/api/**/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "admin-panel/**",
      "use": "@vercel/static"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/admin-panel/api/$1"
    },
    {
      "src": "/admin",
      "dest": "/admin-panel/index.html"
    },
    {
      "src": "/admin/(.*)",
      "dest": "/admin-panel/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}