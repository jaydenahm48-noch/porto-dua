<iframe id="__framer-editorbar" src="https://framer.com/edit?framerSiteId=26fb7ac3f30ff0fcb6677d84f58dfcd6f2c9947cc3e4bb98953974f43008aff1&amp;source=cozy-pixel-room.framer.website&amp;features=%7B%22editorBarDisableFrameAncestorsSecurity%22%3Afalse%2C%22onPageRichTextBlockSelection%22%3Atrue%7D&amp;loadStart=1794167401215" aria-hidden="true" allow="autoplay" tabindex="-1" class="status_hidden"></iframe>


<script>
(function() {
  var img = document.getElementById('pc-img');

  function positionPC() {
    var monitor = document.querySelector('[data-o="p_monitor"]');
    if (!monitor) return;
    var tr = monitor.getBoundingClientRect();
    var container = document.querySelector('.wr-pxs');
    if (!container) return;
    var cr = container.getBoundingClientRect();

    if (img.parentNode !== container) {
      container.appendChild(img);
    }
    img.style.zIndex = '1';
    // kasih canvas z-index eksplisit lebih tinggi
    var pxc = container.querySelector('canvas.wr-pxc');
    if (pxc) pxc.style.zIndex = '2';
    img.style.display = 'block';

    var scale = cr.width / 428;
    var w = Math.round(24 * scale);
    var h = Math.round(w * (img.naturalHeight / img.naturalWidth || 1));
    img.style.width  = w + 'px';
    img.style.height = h + 'px';
    img.style.left = Math.round(234 * scale) + 'px';
    img.style.top  = Math.round(172 * scale) + 'px';
  }

  function start() {
    var monitor = document.querySelector('[data-o="p_monitor"]');
    if (!monitor) { setTimeout(start, 200); return; }
    var r = monitor.getBoundingClientRect();
    if (r.width === 0) { setTimeout(start, 200); return; }
    positionPC();
    window.addEventListener('resize', positionPC);
    // paksa canvas selalu di atas PC
    var pxc = container.querySelector('canvas.wr-pxc');
    if (pxc) pxc.style.zIndex = '2';
  }

  var obs = new MutationObserver(function() {
    if (document.querySelector('[data-o="p_monitor"]')) {
      obs.disconnect();
      setTimeout(start, 100);
    }
  });
  obs.observe(document.body, { childList: true, subtree: true });
})();
</script>

<!-- Pixel art dog on sofa - head turns every 4s -->
<canvas id="pixel-dog" style="position:absolute;pointer-events:auto;z-index:3;image-rendering:pixelated;cursor:pointer;"></canvas>
<div id="dog-tooltip" style="
  position:absolute;
  display:none;
  pointer-events:none;
  z-index:2;
  background:white;
  border:2px solid #333;
  border-radius:3px;
  padding:2px 8px;
  font-family:'Press Start 2P', monospace;
  font-size:10px;
  color:#333;
  white-space:nowrap;
">Jayden</div>

<script>
(function() {
  var canvas = document.getElementById('pixel-dog');
  var ctx = canvas.getContext('2d');
  var SCALE = 3;
  var SW = 12, SH = 14;
  canvas.width  = SW * SCALE;
  canvas.height = SH * SCALE;

  var facingRight = true;

  function px(x, y, w, h, color) {
    ctx.fillStyle = color;
    ctx.fillRect(x*SCALE, y*SCALE, (w||1)*SCALE, (h||1)*SCALE);
  }

  function drawDog() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);

    if (facingRight) {
      // telinga kanan
      px(7,0,2,3,'#c8a06e');
      px(4,0,2,2,'#c8a06e');
      // kepala
      px(3,2,7,5,'#e8c08e');
      // mata
      px(8,3,1,1,'#2a1a0a');
      // moncong
      px(8,5,3,2,'#d4a870');
      px(9,5,2,1,'#4a2f1a'); // hidung
    } else {
      // telinga kiri
      px(1,0,2,3,'#c8a06e');
      px(6,0,2,2,'#c8a06e');
      // kepala
      px(2,2,7,5,'#e8c08e');
      // mata
      px(3,3,1,1,'#2a1a0a');
      // moncong
      px(1,5,3,2,'#d4a870');
      px(1,5,2,1,'#4a2f1a'); // hidung
    }

    // badan (sama di kedua arah)
    px(2,7,8,5,'#c8a06e');
    // collar
    px(2,7,8,1,'#e05080');
    // kaki depan kanan & kiri
    px(2,12,2,2,'#b89060');
    px(7,12,2,2,'#b89060');
    // ekor kecil
    px(10,8,1,2,'#c8a06e');
    px(11,7,1,1,'#c8a06e');
  }

  function positionDog() {
    var sofa = document.querySelector('[data-o="p_sofa"]');
    if (!sofa) return;
    var zoom = document.querySelector('.wr-zoom');
    if (!zoom) return;

    if (canvas.parentNode !== zoom) zoom.appendChild(canvas);

    // Gunakan getBoundingClientRect untuk dapat posisi visual di layar
    var sofaRect = sofa.getBoundingClientRect();
    var zoomRect = zoom.getBoundingClientRect();

    // Hitung scale factor dari .wr-zoom transform
    // sofaRect.width adalah ukuran visual, sofa.style.width adalah ukuran layout asli
    var sofaLayoutW = parseFloat(sofa.style.width) || sofaRect.width;
    var sofaLayoutH = parseFloat(sofa.style.height) || sofaRect.height;
    var scale = sofaRect.width / sofaLayoutW;

    // Posisi sofa relatif terhadap zoom container (dalam koordinat layout)
    // Balik dari screen coords ke layout coords dengan dibagi scale
    var sofaLeft = (sofaRect.left - zoomRect.left) / scale;
    var sofaTop  = (sofaRect.top  - zoomRect.top)  / scale;
    var sofaW    = sofaLayoutW;
    var sofaH    = sofaLayoutH;

    // ukuran anjing proporsional terhadap lebar sofa
    var size = Math.round(sofaW * 0.30);
    canvas.style.width  = size + 'px';
    canvas.style.height = size + 'px';

    // posisi: tengah-kanan sofa, agak ke atas dudukan
    canvas.style.left = Math.round(sofaLeft + sofaW * 0.25) + 'px';
    canvas.style.top  = Math.round(sofaTop  + sofaH * 0.18) + 'px';
  }

  function startDog() {
    var sofa = document.querySelector('[data-o="p_sofa"]');
    if (!sofa) { setTimeout(startDog, 200); return; }
    var r = sofa.getBoundingClientRect();
    if (r.width === 0) { setTimeout(startDog, 200); return; }
    drawDog();
    positionDog();
    // responsive - posisi ulang tiap resize
    window.addEventListener('resize', function() { positionDog(); });
    setInterval(function() {
      facingRight = !facingRight;
      drawDog();
      positionDog();
    }, 4000);

    // tooltip hover + muncul sebentar saat load
    var tooltip = document.getElementById('dog-tooltip');

    function showTooltip() {
      var container = document.querySelector('.wr-pxs');
      if (!container) return;
      var dogRect = canvas.getBoundingClientRect();
      var cr = container.getBoundingClientRect();
      if (tooltip.parentNode !== container) container.appendChild(tooltip);
      tooltip.style.display = 'block';
      tooltip.style.left = (dogRect.left - cr.left + dogRect.width/2 - 30) + 'px';
      tooltip.style.top  = (dogRect.top  - cr.top  - 22) + 'px';
    }

    function hideTooltip() {
      tooltip.style.opacity = '0';
      setTimeout(function() { tooltip.style.display = 'none'; }, 300);
    }

    // muncul sebentar saat load lalu hilang
    tooltip.style.transition = 'opacity 0.5s';
    tooltip.style.opacity = '0';
    tooltip.style.display = 'block';
    showTooltip();
    // fade in
    setTimeout(function() { tooltip.style.opacity = '1'; }, 50);
    // fade out setelah 2 detik
    setTimeout(hideTooltip, 2000);

    var hideTimer;
    canvas.addEventListener('mouseenter', function() {
      clearTimeout(hideTimer);
      showTooltip();
      tooltip.style.opacity = '1';
    });
    canvas.addEventListener('mouseleave', function() {
      hideTimer = setTimeout(hideTooltip, 2000);
    });

    // responsive - update posisi saat resize
    window.addEventListener('resize', function() {
      positionDog();
      if (tooltip.style.display === 'block') showTooltip();
    });

    // reposition saat Framer re-render (popup muncul dll)
    var reposObs = new MutationObserver(function() {
      positionDog();
    });
    reposObs.observe(document.querySelector('.wr-pxs') || document.body, { childList: true, subtree: false });

    // interval cek anjing masih attached dan posisinya benar
    setInterval(function() {
      var zoom = document.querySelector('.wr-zoom');
      if (!zoom) return;
      if (!zoom.contains(canvas)) zoom.appendChild(canvas);
      var container = document.querySelector('.wr-pxs');
      if (tooltip && container && !container.contains(tooltip)) container.appendChild(tooltip);
      positionDog();
    }, 500);

    // klik anjing → lompat + guk guk
    var isJumping = false;
    canvas.addEventListener('click', function() {
      if (isJumping) return;
      isJumping = true;

      // buat speech bubble
      var container = document.querySelector('.wr-pxs');
      var bubble = document.createElement('div');
      bubble.textContent = 'Guk Guk!';
      bubble.style.cssText = 'position:absolute;pointer-events:none;z-index:10;background:white;border:2px solid #333;border-radius:8px;padding:3px 8px;font-family:"Press Start 2P",monospace;font-size:7px;color:#333;white-space:nowrap;transition:opacity 0.3s;';
      container.appendChild(bubble);

      // animasi lompat
      var origTop = parseInt(canvas.style.top);
      var frame = 0;
      var jump = setInterval(function() {
        frame++;
        var offset = -Math.abs(Math.sin(frame * 0.3)) * 15;
        canvas.style.top = (origTop + offset) + 'px';

        // posisi bubble di atas anjing
        var dogRect = canvas.getBoundingClientRect();
        var cr = container.getBoundingClientRect();
        bubble.style.left = (dogRect.left - cr.left + dogRect.width/2 - 35) + 'px';
        bubble.style.top  = (dogRect.top  - cr.top  - 28) + 'px';

        if (frame > 20) {
          clearInterval(jump);
          canvas.style.top = origTop + 'px';
          isJumping = false;
          // fade out bubble
          bubble.style.opacity = '0';
          setTimeout(function() { bubble.remove(); }, 300);
        }
      }, 30);
    });
  }

  // pakai MutationObserver - langsung jalan begitu sofa muncul di DOM
  var observer = new MutationObserver(function() {
    var sofa = document.querySelector('[data-o="p_sofa"]');
    if (sofa) {
      observer.disconnect();
      // tunggu sofa dapat ukuran dulu
      setTimeout(startDog, 100);
    }
  });
  observer.observe(document.body, { childList: true, subtree: true });
})();
</script>
<script>
// Ganti nama kucing Joy
(function() {
  function renamecat() {
    document.querySelectorAll('.wr-pxn').forEach(function(el) {
      if (el.textContent.trim() === 'Miso') el.textContent = 'Noch';
    });
  }
  renamecat();
  var catObs = new MutationObserver(renamecat);
  catObs.observe(document.body, { childList: true, subtree: true, characterData: true });
  // retry beberapa kali
  setTimeout(renamecat, 500);
  setTimeout(renamecat, 1500);
  setTimeout(renamecat, 3000);
})();


</script>

<script>
// Ganti FolioOS → NochyOS di semua teks dalam desktop
(function() {
  function renameOS() {
    // Walk semua text nodes rekursif — scan SELURUH document bukan cuma .wr-os
    function walkText(node) {
      if (node.nodeType === 3) {
        if (node.textContent.includes('FolioOS')) {
          node.textContent = node.textContent.replace(/FolioOS/g, 'NochyOS');
        }
      } else if (node.nodeType === 1) {
        node.childNodes.forEach(walkText);
      }
    }
    // Target semua container yang mungkin punya teks FolioOS
    document.querySelectorAll('.wr-os, .wr-bzb, .wr-bz, .wr-mod').forEach(walkText);

    // Ganti logo di menu bar → img1.png
    var mn = document.querySelector('.wr-os .wr-mn');
    if (mn) {
      var firstBtn = mn.querySelector('button');
      if (firstBtn) {
        if (!firstBtn.dataset.logoPatched) {
          firstBtn.dataset.logoPatched = '1';
          firstBtn.innerHTML = '';
          var img = document.createElement('img');
          img.src = 'framerusercontent-com/sites/icons/img1.png';
          img.style.cssText = 'width:16px;height:16px;image-rendering:pixelated;vertical-align:middle;display:block;';
          firstBtn.appendChild(img);
        }
        // Override CSS gear dengan !important via setAttribute style
        firstBtn.setAttribute('style', 'background-image:none!important;background-color:transparent!important;width:auto!important;padding:0 6px!important;');
      }
    }
  }
  renameOS();
  var obs = new MutationObserver(renameOS);
  obs.observe(document.body, { childList: true, subtree: true, characterData: true });
  setTimeout(renameOS, 500);
  setTimeout(renameOS, 1500);
  setTimeout(renameOS, 3000);
})();
</script>

<script>
// ── NOCHYOS API INTEGRATION ───────────────────────────────
// Fetch projects dari API dan inject ke desktop sebagai icon
(function() {
  // Ganti ini dengan URL Vercel kamu setelah deploy

  // Inject CSS
  var style = document.createElement('style');
  style.textContent = `
    #nochy-popup {
      display:none; position:fixed; inset:0; z-index:2147483647;
      background:rgba(100,120,160,0.45);
      font-family:'Press Start 2P', monospace;
    }
    #nochy-popup.open { display:flex; align-items:center; justify-content:center; animation: npIn 0.15s ease; }
    @keyframes npIn { from { opacity:0; transform:scale(0.96); } }
    #nochy-popup-inner {
      width:480px; max-width:92vw; max-height:86vh;
      background:#fff; color:#000;
      border:2px solid #000;
      box-shadow:4px 4px 0 rgba(0,0,0,0.5);
      display:flex; flex-direction:column;
      overflow:hidden;
    }
    /* Title bar */
    #nochy-popup-titlebar {
      flex:none; height:22px; min-height:22px;
      background:repeating-linear-gradient(#000 0px,#000 2px,#fff 2px,#fff 4px);
      display:flex; align-items:center; justify-content:center;
      position:relative; cursor:move;
    }
    #nochy-popup-titlebar span {
      background:#fff; padding:0 8px;
      font-size:9px; color:#000; line-height:14px;
      font-family:'Press Start 2P', monospace;
    }
    #nochy-popup-close {
      position:absolute; left:4px; top:3px;
      width:16px; height:16px;
      background:#fff; border:2px solid #000;
      cursor:pointer; font-size:0; padding:0;
      display:flex; align-items:center; justify-content:center;
    }
    #nochy-popup-close::after {
      content:'✕'; font-size:8px; color:#000;
      font-family:monospace; line-height:1;
    }
    #nochy-popup-close:hover { background:#000; }
    #nochy-popup-close:hover::after { color:#fff; }
    /* Scrollable body */
    #nochy-popup-scroll {
      overflow-y:auto; overflow-x:hidden;
      scrollbar-width:thin; scrollbar-color:#999 #eee;
    }
    #nochy-popup-scroll::-webkit-scrollbar { width:8px; }
    #nochy-popup-scroll::-webkit-scrollbar-track { background:#eee; }
    #nochy-popup-scroll::-webkit-scrollbar-thumb { background:#999; }
    #nochy-popup-hero {
      width:100%; height:180px; object-fit:cover; display:block;
      border-bottom:2px solid #000; background:#ddd;
    }
    #nochy-popup-body { padding:14px 16px 20px; background:#fff; color:#000; }
    #nochy-popup-title {
      font-size:10px; line-height:1.6; color:#000; margin-bottom:10px;
    }
    #nochy-popup-desc {
      font-family:'Pixelify Sans', sans-serif; font-size:13px;
      line-height:1.7; color:#333; margin-bottom:14px;
    }
    #nochy-popup-tags { display:flex; flex-wrap:wrap; gap:5px; margin-bottom:16px; }
    #nochy-popup-tags span {
      padding:3px 7px; border:1.5px solid #000;
      font-size:8px; color:#000; font-family:'Pixelify Sans', sans-serif;
    }
    #nochy-popup-btns { display:flex; gap:8px; margin-bottom:20px; flex-wrap:wrap; }
    #nochy-popup-btns a {
      padding:8px 14px; font-size:8px; text-decoration:none;
      display:flex; align-items:center; gap:5px;
      font-family:'Press Start 2P', monospace;
      border:2px solid #000; color:#000; background:#fff;
      box-shadow:2px 2px 0 #000;
      transition: background 0.15s, color 0.15s;
    }
    #nochy-popup-btns a:hover { background:#000; color:#fff; }
    .np-btn-visit { background:#000 !important; color:#fff !important; }
    .np-btn-visit:hover { background:#fff !important; color:#000 !important; }
    #nochy-popup-gallery-title {
      font-size:8px; color:#000; margin-bottom:10px; border-bottom:2px solid #000; padding-bottom:6px;
    }
    #nochy-popup-gallery {
      display:grid; grid-template-columns:repeat(3,1fr); gap:4px;
    }
    #nochy-popup-gallery img {
      width:100%; aspect-ratio:4/3; object-fit:cover;
      cursor:pointer; border:2px solid #ccc;
      transition:border-color 0.1s;
    }
    #nochy-popup-gallery img:hover { border-color:#000; }
    /* corner resize indicator */
    #nochy-popup-inner::after {
      content:''; position:absolute; bottom:0; right:0;
      width:12px; height:12px;
      background:linear-gradient(135deg, transparent 50%, #000 50%);
      pointer-events:none;
    }
    #nochy-lightbox {
      display:none; position:fixed; inset:0; z-index:2147483647;
      background:rgba(0,0,0,0.92); align-items:center; justify-content:center;
    }
    #nochy-lightbox.open { display:flex; }
    #nochy-lightbox img {
      max-width:88vw; max-height:84vh; object-fit:contain;
      border:3px solid #fff;
    }
    #nochy-lb-prev, #nochy-lb-next {
      position:fixed; top:50%; transform:translateY(-50%);
      width:40px; height:40px; background:#fff; color:#000;
      border:2px solid #000; cursor:pointer; font-size:16px;
      display:flex; align-items:center; justify-content:center;
    }
    #nochy-lb-prev:hover, #nochy-lb-next:hover { background:#000; color:#fff; }
    #nochy-lb-prev { left:12px; }
    #nochy-lb-next { right:12px; }
    #nochy-lb-close {
      position:fixed; top:12px; right:12px;
      width:36px; height:36px; background:#fff; color:#000;
      border:2px solid #000; cursor:pointer; font-size:14px;
      display:flex; align-items:center; justify-content:center;
    }
    #nochy-lb-close:hover { background:#000; color:#fff; }
    #nochy-lb-counter {
      position:fixed; bottom:14px; left:50%; transform:translateX(-50%);
      color:#fff; font-size:10px; font-family:monospace;
      background:rgba(0,0,0,0.6); padding:4px 12px;
    }
  `;
  document.head.appendChild(style);

  // Popup HTML
  var popup = document.createElement('div');
  popup.id = 'nochy-popup';
  popup.innerHTML = `
    <div id="nochy-popup-inner">
      <div id="nochy-popup-titlebar">
        <button id="nochy-popup-close"></button>
        <span>Nochy Eat</span>
      </div>
      <div id="nochy-popup-scroll">
        <img id="nochy-popup-hero" src="framerusercontent-com/sites/icons/BG-SORE.jpg" />
        <div id="nochy-popup-body">
          <div id="nochy-popup-title">Nochy Eat - On-Demand Food Delivery & Realtime Order Tracking App</div>
          <div id="nochy-popup-desc">Aplikasi layanan pesan-antar makanan berbasis Flutter (Android & iOS) dengan sistem multi-role yang terintegrasi (Customer, Driver, dan Seller). Dilengkapi fitur pelacakan posisi driver secara realtime menggunakan flutter_map & OpenStreetMap melalui Supabase Realtime Channel, sistem pembayaran ganda (Midtrans Payment Gateway & Nochy Coins), serta manajemen voucher/diskon bertingkat dari platform maupun merchant seller.</div>
          <div id="nochy-popup-tags">
            <span>Flutter</span><span>Dart</span><span>PostgreSQL</span>
            <span>Supabase</span><span>Midtrans API</span><span>OpenStreetMap</span>
            <span>Geolocator</span><span>Supabase Realtime</span>
          </div>
          <div id="nochy-popup-btns">
            <a href="https://github.com" target="_blank" class="np-btn-gh">⬡ GitHub</a>
            <a href="https://nochyeat.com" target="_blank" class="np-btn-visit">↗ Lihat Project</a>
          </div>
          <div id="nochy-popup-gallery-title">📁 Dokumentasi</div>
          <div id="nochy-popup-gallery"></div>
        </div>
      </div>
    </div>
  `;
  document.body.appendChild(popup);

  // Lightbox HTML
  var lb = document.createElement('div');
  lb.id = 'nochy-lightbox';
  lb.innerHTML = `
    <button id="nochy-lb-close">✕</button>
    <button id="nochy-lb-prev">←</button>
    <img id="nochy-lb-img" src="" />
    <button id="nochy-lb-next">→</button>
    <div id="nochy-lb-counter"></div>
  `;
  document.body.appendChild(lb);

  // Isi galeri
  var images = [];
  var gallery = document.getElementById('nochy-popup-gallery');
  if (!images.length) {
    var gTitle = document.getElementById('nochy-popup-gallery-title');
    if (gTitle) gTitle.style.display = 'none';
  }
  images.forEach(function(src, i) {
    var img = document.createElement('img');
    img.src = src;
    img.addEventListener('click', function() { openLightbox(i); });
    gallery.appendChild(img);
  });

  // Lightbox logic
  var lbIdx = 0;
  function openLightbox(i) {
    lbIdx = i;
    document.getElementById('nochy-lb-img').src = images[i];
    document.getElementById('nochy-lb-counter').textContent = (i+1) + ' / ' + images.length;
    lb.classList.add('open');
  }
  document.getElementById('nochy-lb-close').onclick = function() { lb.classList.remove('open'); };
  document.getElementById('nochy-lb-prev').onclick = function() {
    lbIdx = (lbIdx - 1 + images.length) % images.length;
    document.getElementById('nochy-lb-img').src = images[lbIdx];
    document.getElementById('nochy-lb-counter').textContent = (lbIdx+1) + ' / ' + images.length;
  };
  document.getElementById('nochy-lb-next').onclick = function() {
    lbIdx = (lbIdx + 1) % images.length;
    document.getElementById('nochy-lb-img').src = images[lbIdx];
    document.getElementById('nochy-lb-counter').textContent = (lbIdx+1) + ' / ' + images.length;
  };
  document.getElementById('nochy-popup-close').onclick = function() {
    popup.classList.remove('open');
  };

  // Intercept klik Nochy Eat di desktop
  function attachClick() {
    document.querySelectorAll('.wr-os .wr-ic').forEach(function(btn) {
      if (btn.dataset.nochyBound) return;
      var label = btn.querySelector('span');
      if (label && label.textContent.trim() === 'Nochy Eat') {
        btn.dataset.nochyBound = '1';
        btn.addEventListener('click', function(e) {
          e.stopPropagation();
          popup.classList.add('open');
        }, true);
      }
    });
  }

  var obs = new MutationObserver(attachClick);
  obs.observe(document.body, { childList: true, subtree: true });
  setInterval(attachClick, 500);
})();
</script>

<script>
// ── NOCHYOS API INTEGRATION ───────────────────────────────
// Fetch projects dari API dan inject ke desktop sebagai icon
(function() {
  // Ganti ini dengan URL Vercel kamu setelah deploy
  // Kalau masih local: 'http://localhost:3000'
  var API_BASE = window.NOCHYOS_API || '';

  if (!API_BASE) return; // Skip kalau API belum diset

  var apiProjects = [];

  // ── Fetch projects + files dari API ───────────────────
  async function fetchProjects() {
    try {
      var [pjRes, fRes] = await Promise.all([
        fetch(API_BASE + '/api/projects').then(function(r) { return r.json(); }).catch(function() { return { status: 'ok', data: [] }; }),
        fetch(API_BASE + '/api/files').then(function(r) { return r.json(); }).catch(function() { return { status: 'ok', data: [] }; }),
      ]);
      var projList = (pjRes.status === 'ok') ? pjRes.data : [];
      apiProjects = projList;
      var items = projList.map(function(p) {
        return {
          id: p.id,
          kind: 'project',
          title: p.judul,
          folder: 'Work',
          page: 1,
          desc: p.deskripsi,
          skills: Array.isArray(p.teknologi) ? p.teknologi : String(p.teknologi || '').split(',').map(function(s){ return s.trim(); }).filter(Boolean),
          link: p.link_project || '',
          github: p.github_url || '',
          demo: p.demo_url || '',
          image: p.url_thumbnail || '',
        };
      });
      if (fRes.status === 'ok') {
        var fileList = fRes.data || [];
        for (var i = 0; i < fileList.length; i++) {
          var f = fileList[i];
          if (!f || f.kind === 'project') continue;
          items.push({
            id: f.id,
            kind: f.kind,
            title: f.title,
            folder: f.folder || '',
            page: f.page || 1,
            desc: f.desc || '',
            skills: Array.isArray(f.skills) ? f.skills : String(f.skills || '').split(',').map(function(s){ return s.trim(); }).filter(Boolean),
            link: f.link || '',
            image: f.image || '',
          });
        }
      }
      window.NOCHY_FILES = items;
      window.dispatchEvent(new Event('nochy:files'));
      setupProjectPopups();
    } catch (e) { console.warn('NochyOS API:', e.message); }
  }

  // ── Setup click handler untuk popup project ───────────
  function setupProjectPopups() {
    // Buat popup container kalau belum ada
    if (!document.getElementById('api-project-popup')) {
      createPopupHTML();
    }
    attachProjectClicks();
    var obsP = new MutationObserver(function() { attachProjectClicks(); });
    obsP.observe(document.body, { childList: true, subtree: true });
    setInterval(attachProjectClicks, 800);
  }

  // ── Bind klik ke icon project di OS NochyOS ───────────
  function attachProjectClicks() {
    var icons = document.querySelectorAll('.wr-ic');
    icons.forEach(function(btn) {
      if (btn.dataset.nochyProjBound) return;
      var label = btn.querySelector('.l');
      var name = label ? String(label.textContent || '').trim() : '';
      var filesList = window.NOCHY_FILES || [];
      var hit = null;
      for (var i = 0; i < filesList.length; i++) {
        if (filesList[i] && filesList[i].kind === 'project' && String(filesList[i].title || '') === name) { hit = filesList[i]; break; }
      }
      if (!hit) return;
      btn.dataset.nochyProjBound = '1';
      btn.addEventListener('click', function(e) {
        e.stopPropagation();
        e.preventDefault();
        var full = null;
        var list = apiProjects || [];
        for (var q = 0; q < list.length; q++) {
          if (list[q].id === hit.id) { full = list[q]; break; }
        }
        if (full) {
          openApiPopup(full);
        } else {
          openApiPopup({
            id: hit.id,
            judul: hit.title,
            kategori: '',
            deskripsi: hit.desc || '',
            url_thumbnail: hit.image || '',
            link_project: hit.link || '',
            teknologi: Array.isArray(hit.skills) ? hit.skills : String(hit.skills || '').split(',').map(function(s){ return s.trim(); }).filter(Boolean),
            gambar_detail: [],
          });
        }
      }, true);
    });
  }

  // ── Buat popup HTML ───────────────────────────────────
  function createPopupHTML() {
    var style = document.createElement('style');
    style.textContent = `
      #api-project-popup {
        display:none; position:fixed; inset:0; z-index:2147483647;
        background:rgba(100,120,160,0.45);
        font-family:'Press Start 2P', monospace;
        align-items:center; justify-content:center;
      }
      #api-project-popup.open { display:flex; animation: npIn 0.15s ease; }
      @keyframes npIn { from { opacity:0; transform:scale(0.96); } }
      #api-popup-inner {
        width:480px; max-width:92vw; max-height:86vh;
        background:#fff; color:#000;
        border:2px solid #000; box-shadow:4px 4px 0 rgba(0,0,0,0.5);
        display:flex; flex-direction:column; overflow:hidden;
      }
      #api-popup-titlebar {
        flex:none; height:22px;
        background:repeating-linear-gradient(#000 0px,#000 2px,#fff 2px,#fff 4px);
        display:flex; align-items:center; justify-content:center;
        position:relative; cursor:move;
      }
      #api-popup-titlebar span {
        background:#fff; padding:0 8px; font-size:9px; color:#000; line-height:14px;
      }
      #api-popup-close {
        position:absolute; left:4px; top:3px; width:16px; height:16px;
        background:#fff; border:2px solid #000; cursor:pointer;
        display:flex; align-items:center; justify-content:center; font-size:0;
      }
      #api-popup-close::after { content:'✕'; font-size:8px; color:#000; font-family:monospace; }
      #api-popup-close:hover { background:#000; }
      #api-popup-close:hover::after { color:#fff; }
      #api-popup-scroll { overflow-y:auto; scrollbar-width:thin; }
      #api-popup-hero { width:100%; height:180px; object-fit:cover; display:block; border-bottom:2px solid #000; background:#ddd; }
      #api-popup-body { padding:14px 16px 20px; }
      #api-popup-title { font-size:10px; line-height:1.6; margin-bottom:10px; }
      #api-popup-desc { font-family:'Pixelify Sans',sans-serif; font-size:13px; line-height:1.7; color:#333; margin-bottom:14px; }
      #api-popup-tags { display:flex; flex-wrap:wrap; gap:5px; margin-bottom:16px; }
      #api-popup-tags span { padding:3px 7px; border:1.5px solid #000; font-size:8px; }
      #api-popup-btns { display:flex; gap:8px; margin-bottom:20px; flex-wrap:wrap; }
      #api-popup-btns a {
        padding:8px 14px; font-size:8px; text-decoration:none;
        display:flex; align-items:center; gap:5px;
        border:2px solid #000; color:#000; background:#fff;
        box-shadow:2px 2px 0 #000; transition:background 0.15s, color 0.15s;
      }
      #api-popup-btns a:hover { background:#000; color:#fff; }
      #api-popup-gallery { display:grid; grid-template-columns:repeat(3,1fr); gap:4px; }
      #api-popup-gallery img { width:100%; aspect-ratio:4/3; object-fit:cover; cursor:pointer; border:2px solid #ccc; }
      #api-popup-gallery img:hover { border-color:#000; }
      #api-popup-lightbox { display:none; position:fixed; inset:0; z-index:2147483647; background:rgba(0,0,0,0.85); align-items:center; justify-content:center; cursor:zoom-out; }
      #api-popup-lightbox.open { display:flex; }
      #api-popup-lightbox img { max-width:90vw; max-height:90vh; object-fit:contain; border:4px solid #fff; box-shadow:0 0 0 4px #000; }
      #api-popup-gallery-title { font-size:8px; color:#000; margin-bottom:10px; border-bottom:2px solid #000; padding-bottom:6px; }
    `;
    document.head.appendChild(style);

    var popup = document.createElement('div');
    popup.id = 'api-project-popup';
    popup.innerHTML = `
      <div id="api-popup-inner">
        <div id="api-popup-titlebar">
          <button id="api-popup-close" onclick="document.getElementById('api-project-popup').classList.remove('open')"></button>
          <span id="api-popup-name">Project</span>
        </div>
        <div id="api-popup-scroll">
          <img id="api-popup-hero" src="" />
          <div id="api-popup-body">
            <div id="api-popup-title"></div>
            <div id="api-popup-desc"></div>
            <div id="api-popup-tags"></div>
            <div id="api-popup-btns"></div>
            <div id="api-popup-gallery-title">📁 Dokumentasi</div>
            <div id="api-popup-gallery"></div>
          </div>
        </div>
      </div>
    `;
    document.body.appendChild(popup);

    // Lightbox untuk foto dokumentasi
    var lightbox = document.createElement('div');
    lightbox.id = 'api-popup-lightbox';
    lightbox.innerHTML = '<img id="api-popup-lightbox-img" src="" alt="" referrerpolicy="no-referrer" />';
    lightbox.addEventListener('click', function() {
      lightbox.classList.remove('open');
      var lbimg = document.getElementById('api-popup-lightbox-img');
      if (lbimg) lbimg.src = '';
    });
    document.body.appendChild(lightbox);

    // Close on overlay click
    popup.addEventListener('click', function(e) {
      if (e.target === popup) {
        popup.classList.remove('open');
        var lb = document.getElementById('api-popup-lightbox');
        if (lb) lb.classList.remove('open');
        var lbimg = document.getElementById('api-popup-lightbox-img');
        if (lbimg) lbimg.src = '';
      }
    });
  }

  // ── Open popup dengan data project ───────────────────
  function openApiPopup(project) {
    var popup = document.getElementById('api-project-popup');
    if (!popup) return;

    // Title bar
    document.getElementById('api-popup-name').textContent = project.judul;

    // Hero image
    var hero = document.getElementById('api-popup-hero');
    hero.referrerPolicy = 'no-referrer';
    hero.decoding = 'async';
    if (project.url_thumbnail) {
      hero.src = project.url_thumbnail;
      hero.style.display = 'block';
    } else {
      hero.style.display = 'none';
    }

    // Title & desc
    document.getElementById('api-popup-title').textContent = project.judul;
    document.getElementById('api-popup-desc').textContent = project.deskripsi;

    // Tags (teknologi)
    var tags = document.getElementById('api-popup-tags');
    tags.innerHTML = '';
    var techs = Array.isArray(project.teknologi) ? project.teknologi : [];
    techs.forEach(function(t) {
      var span = document.createElement('span');
      span.textContent = t;
      tags.appendChild(span);
    });

    // Buttons
    var btns = document.getElementById('api-popup-btns');
    btns.innerHTML = '';
    // Tentukan link demo vs github (dedupe supaya tidak double)
    var demoUrl = project.demo_url || '';
    var githubUrl = project.github_url || '';
    if (!demoUrl && project.link_project && !/github\.com/i.test(project.link_project)) demoUrl = project.link_project;
    if (!githubUrl && project.link_project && /github\.com/i.test(project.link_project)) githubUrl = project.link_project;

    if (demoUrl) {
      var a = document.createElement('a');
      a.href = demoUrl;
      a.target = '_blank';
      a.rel = 'noopener';
      a.innerHTML = '↗ Lihat Project';
      a.className = 'np-btn-visit';
      btns.appendChild(a);
    }
    if (githubUrl && githubUrl !== demoUrl) {
      var g = document.createElement('a');
      g.href = githubUrl;
      g.target = '_blank';
      g.rel = 'noopener';
      g.innerHTML = '↗ Lihat GitHub';
      g.className = 'np-btn-visit';
      btns.appendChild(g);
    }

    // Gallery
    var gallery = document.getElementById('api-popup-gallery');
    gallery.innerHTML = '';
    var imgs = Array.isArray(project.gambar_detail) ? project.gambar_detail : [];
    var galleryTitle = document.getElementById('api-popup-gallery-title');
    galleryTitle.style.display = imgs.length ? 'block' : 'none';

    imgs.forEach(function(url) {
      if (!url) return;
      var img = document.createElement('img');
      img.referrerPolicy = 'no-referrer';
      img.src = url;
      img.alt = project.judul;
      img.addEventListener('click', function() {
        var lb = document.getElementById('api-popup-lightbox');
        var lbimg = document.getElementById('api-popup-lightbox-img');
        if (lb && lbimg) { lbimg.src = url; lbimg.referrerPolicy = 'no-referrer'; lb.classList.add('open'); }
      });
      gallery.appendChild(img);
    });

    popup.classList.add('open');
  }

  // ── Klik icon project dari OS NochyOS (data dari /api/files) ──
  document.addEventListener('click', function(e) {
    var ic = e.target && e.target.closest ? e.target.closest('.wr-ic') : null;
    if (!ic) return;
    var label = ic.querySelector('.l');
    var name = label ? String(label.textContent || '').trim() : '';
    if (!name) return;
    var filesList = window.NOCHY_FILES || [];
    var hit = null;
    for (var i = 0; i < filesList.length; i++) {
      if (filesList[i] && filesList[i].kind === 'project' && String(filesList[i].title || '') === name) { hit = filesList[i]; break; }
    }
    if (!hit) return;
    e.stopPropagation();
    e.preventDefault();
    var full = null;
    var list = apiProjects || [];
    for (var q = 0; q < list.length; q++) {
      if (list[q].id === hit.id) { full = list[q]; break; }
    }
    if (full) {
      openApiPopup(full);
    } else {
      openApiPopup({
        id: hit.id,
        judul: hit.title,
        kategori: '',
        deskripsi: hit.desc || '',
        url_thumbnail: hit.image || '',
        link_project: hit.link || '',
        github_url: hit.github || '',
        demo_url: hit.demo || '',
        teknologi: Array.isArray(hit.skills) ? hit.skills : String(hit.skills || '').split(',').map(function(s){ return s.trim(); }).filter(Boolean),
        gambar_detail: [],
      });
    }
  }, true);

  // ── Start ─────────────────────────────────────────────
  // Tunggu DOM siap baru fetch
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', fetchProjects);
  } else {
    fetchProjects();
  }

  })();
</script>

</body></html>