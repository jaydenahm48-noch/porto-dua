th: 157.08px; height: 181.72px; min-width: 36.96px; min-height: 36.96px;"></div><div class="wr-kb" data-o="p_monstera" tabindex="0" role="button" aria-label="p_monstera" style="left: 822.36px; top: 766.92px; width: 101.64px; height: 141.68px; min-width: 36.96px; min-height: 36.96px;"></div><div class="wr-kb" data-o="p_curtain" tabindex="0" role="button" aria-label="p_curtain" style="left: 320.32px; top: 117.04px; width: 631.4px; height: 511.28px; min-width: 36.96px; min-height: 36.96px;"></div></div></div><div class="wr-amb" data-m="sunset" aria-hidden="true"><i style="left: 11%; top: 17%; animation-delay: 0s; animation-duration: 5s;"></i><i style="left: 48%; top: 70%; animation-delay: 0.61s; animation-duration: 6s;"></i><i style="left: 85%; top: 43%; animation-delay: 1.22s; animation-duration: 7s;"></i><i style="left: 26%; top: 16%; animation-delay: 1.83s; animation-duration: 8s;"></i><i style="left: 63%; top: 69%; animation-delay: 2.44s; animation-duration: 9s;"></i><i style="left: 4%; top: 42%; animation-delay: 3.05s; animation-duration: 5s;"></i><i style="left: 41%; top: 15%; animation-delay: 3.66s; animation-duration: 6s;"></i><i style="left: 78%; top: 68%; animation-delay: 4.27s; animation-duration: 7s;"></i><i style="left: 19%; top: 41%; animation-delay: 4.88s; animation-duration: 8s;"></i><i style="left: 56%; top: 14%; animation-delay: 0.49s; animation-duration: 9s;"></i><i style="left: 93%; top: 67%; animation-delay: 1.1s; animation-duration: 5s;"></i><i style="left: 34%; top: 40%; animation-delay: 1.71s; animation-duration: 6s;"></i><i style="left: 71%; top: 13%; animation-delay: 2.32s; animation-duration: 7s;"></i><i style="left: 12%; top: 66%; animation-delay: 2.93s; animation-duration: 8s;"></i></div><div class="wr-fxl" aria-hidden="true"></div><div class="wr-tip" role="status" aria-live="polite" style="transform: translate(1542px, 175px);"></div><div class="wr-nav"><button type="button">WORK</button><button type="button">ABOUT</button><button type="but