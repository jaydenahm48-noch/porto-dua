.wr-pgr { position: absolute; left: 50%; bottom: 8px; z-index: 60; display: flex; align-items: center; gap: 8px; padding: 4px 8px; transform: translateX(-50%); background: #fff; border: 2px solid #000; box-shadow: 2px 2px 0 #000; font-size: 13px; }
.wr-pgr .wr-bt { height: 22px; padding: 0 8px; }
.wr-pgw { font-style: normal; }
.wr-pxn { position: absolute; z-index: 4; transform: translate(-50%, -100%); white-space: nowrap; padding: 2px 5px; font: 400 8px/10px var(--wr-hd, "Press Start 2P", "Pixelify Sans", ui-monospace, monospace); color: #2a2438; background: #fff; box-shadow: 0 0 0 2px #2a2438; pointer-events: none; opacity: 0; transition: opacity .25s steps(3); }
.wr-mod[data-k="art"] .wr-mbox { width: min(420px, 100%); }
.wr-mod[data-k="books"] .wr-mbox { width: min(470px, 100%); }
.wr-pnt { display: flex; flex-direction: column; align-items: center; gap: 8px; text-align: center; }
.wr-pntf { padding: 8px; background: #fff; border: 2px solid #000; box-shadow: 0 0 0 3px #c79a45, 0 0 0 5px #000; max-width: 100%; box-sizing: border-box; }
.wr-pntc { display: block; width: 180px; max-width: 100%; aspect-ratio: 40 / 68; image-rendering: pixelated; }
.wr-pntf img { display: block; max-width: 100%; max-height: 52vh; }
.wr-pntf[data-empty] { padding: 30px 18px; font-size: 13px; line-height: 17px; }
.wr-pnt h3 { margin: 6px 0 0; font: 700 16px/20px var(--wr-px, "Pixelify Sans", "Silkscreen", "VT323", ui-monospace, monospace); }
.wr-pnt p { margin: 0; font-size: 14px; line-height: 18px; }
.wr-bk { display: flex; flex-direction: column; gap: 8px; }
.wr-bkt { display: flex; flex-wrap: wrap; gap: 4px; }
.wr-bkt button { height: 24px; padding: 0 8px; border: 2px solid #000; background: #fff; color: #000; font: 400 13px/1 var(--wr-px, "Pixelify Sans", "Silkscreen", "VT323", ui-monospace, monospace); cursor: pointer; }
.wr-bkt button[data-on] { background: #000; color: #fff; }
.wr-bk ul { list-style: none; margin: 0; padding: 0 4px 3px 0; display: flex; flex-direction: column; gap: 7px; max-height: 50vh; overflow: auto; }
.wr-bk li { display: flex; align-items: center; gap: 8px; padding: 6px 8px; border: 2px solid #000; background: #fff; box-shadow: 2px 2px 0 #000; }
.wr-bk li > div { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 1px; }
.wr-bk li b { font-size: 14px; line-height: 16px; }
.wr-bk li span, .wr-bk li em { font-size: 12px; line-height: 14px; font-style: normal; opacity: .75; }
.wr-bks { flex: none; width: 10px; height: 36px; border: 2px solid #000; }
.wr-bk li u { flex: none; text-decoration: none; font-size: 10px; line-height: 12px; padding: 2px 4px; border: 2px solid #000; background: var(--ac); color: var(--acink); }
.wr-bk li[data-s="done"] u { background: #fff; color: #000; }
.wr-bk li a { flex: none; display: grid; place-items: center; width: 24px; height: 24px; border: 2px solid #000; color: #000; text-decoration: none; }
.wr-bk li a:hover { background: #000; color: #fff; }
.wr-bke { margin: 6px 0; font-size: 13px; }
.wr-w2[data-k="music"] { width: 340px; }
.wr-mp { display: flex; flex-direction: column; gap: 9px; width: 100%; box-sizing: border-box; }
.wr-mpl { padding: 8px 9px 9px; background: #b9cba3; color: #1d2a17; border: 2px solid #000; box-shadow: inset 2px 2px 0 rgba(29, 42, 23, .28); }
.wr-mpt { overflow: hidden; white-space: nowrap; font-size: 14px; line-height: 18px; padding-bottom: 4px; border-bottom: 2px solid #1d2a17; }
.wr-mpt span { display: inline-block; }
.wr-mpt span[data-run] { animation: wr-mq 14s linear infinite; }
@keyframes wr-mq { to { transform: translateX(-50%); } }
.wr-mps { display: flex; justify-content: space-between; margin-top: 4px; font-size: 12px; line-height: 14px; }
.wr-mpl .wr-eq { height: 36px; gap: 3px; justify-content: center; margin-top: 6px; }
.wr-mpl .wr-eq i { width: 10px; background: #1d2a17; box-shadow: none; }
.wr-mpl .wr-eq[data-on] i { animation-name: wr-eqm; }
@keyframes wr-eqm { from { height: 4px; } to { height: 34px; } }
.wr-mpb { height: 12px; margin-top: 7px; border: 2px solid #1d2a17; cursor: pointer; touch-action: none; }
.wr-mpb i { display: block; height: 100%; background: #1d2a17; }
.wr-mpc { display: grid; grid-template-columns: 1fr 2.6fr 1fr 1fr; gap: 6px; align-items: stretch; }
.wr-mpc .wr-bt, .wr-mpc .wr-bt[data-def] { height: 34px; margin: 0; padding: 0; box-shadow: none; min-width: 0; font-size: 13px; }
.wr-bt:disabled { opacity: .4; cursor: default; }
.wr-bt:disabled:hover { color: #000; background: #fff; }
.wr-bt[data-on] { color: #fff; background: #000; }
.wr-mpv { display: flex; align-items: center; gap: 8px; font-size: 12px; }
.wr-mpv input { flex: 1; min-width: 0; height: 12px; margin: 0; appearance: none; -webkit-appearance: none; border: 2px solid #000; background: #fff; cursor: pointer; }
