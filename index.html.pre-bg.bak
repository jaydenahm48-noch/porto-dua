.wr-bkt2 { position: fixed; z-index: 2147483000; max-width: 220px; min-width: 90px; padding: 6px 8px; transform: translate(-50%, -100%); pointer-events: none; text-align: center; color: #000; background: #fffdf2; border: 2px solid #000; box-shadow: 2px 2px 0 rgba(0,0,0,.5); animation: wr-tipin .12s steps(2) backwards; }
@keyframes wr-tipin { from { opacity: 0; } }
.wr-bkt2[data-b] { transform: translate(-50%, 0); }
.wr-bkt2 b { display: block; font: 400 13px/16px var(--wr-px, "Pixelify Sans", "Silkscreen", "VT323", ui-monospace, monospace); }
.wr-bkt2 span { display: block; margin-top: 2px; font: 400 12px/14px var(--wr-px, "Pixelify Sans", "Silkscreen", "VT323", ui-monospace, monospace); opacity: .7; }
.wr-bkt2 u { display: inline-block; margin-top: 4px; padding: 1px 4px; text-decoration: none; font: 400 9px/12px var(--wr-px, "Pixelify Sans", "Silkscreen", "VT323", ui-monospace, monospace); background: var(--ac); color: var(--acink); border: 1px solid #000; }
.wr-spw { flex: none; height: 148px; display: flex; align-items: flex-end; }
.wr-spn { position: relative; width: 100%; padding: 0; border: 0; border-radius: 2px 2px 0 0; cursor: pointer; background: linear-gradient(transparent 0 8px, #e2b25a 8px 10px, transparent 10px calc(100% - 10px), #e2b25a calc(100% - 10px) calc(100% - 8px), transparent calc(100% - 8px)), linear-gradient(90deg, rgba(255,255,255,.18) 0 3px, transparent 3px calc(100% - 4px), rgba(0,0,0,.28) calc(100% - 4px)), var(--c); box-shadow: 0 0 0 2px #14091a; color: #fff6dc; transition: transform .12s steps(2); }
.wr-spn span { display: block; position: absolute; inset: 14px 0; writing-mode: vertical-rl; text-align: left; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font: 400 12px/30px var(--wr-px, "Pixelify Sans", "Silkscreen", "VT323", ui-monospace, monospace); padding: 0 1px; text-shadow: 1px 1px 0 rgba(0,0,0,.45); }
.wr-spn:hover { transform: translateY(-4px); }
.wr-spn[data-sel] { transform: translateY(-12px); box-shadow: 0 0 0 2px #14091a, 0 0 0 4px #ffd36a; }
.wr-spn[data-s="reading"]::before { content: ""; position: absolute; left: 50%; top: -6px; width: 8px; height: 10px; margin-left: -4px; background: #d9475e; box-shadow: 0 0 0 2px #14091a; }
.wr-spn[data-s="done"]::after { content: "★"; position: absolute; left: 0; right: 0; bottom: 1px; font-size: 9px; line-height: 10px; text-align: center; color: #ffd36a; }
.wr-bkd { padding: 10px 12px; border: 2px solid #000; background: #fff; box-shadow: 3px 3px 0 #000; display: flex; flex-direction: column; gap: 6px; }
.wr-bkd h4 { margin: 0; font: 700 15px/18px var(--wr-px, "Pixelify Sans", "Silkscreen", "VT323", ui-monospace, monospace); }
.wr-bkd > em { font-style: normal; font-size: 12px; opacity: .7; }
.wr-bkg { display: flex; align-items: center; gap: 8px; font-size: 12px; }
.wr-bkg u { flex: none; text-decoration: none; padding: 2px 5px; border: 2px solid #000; background: var(--ac); color: var(--acink); font-size: 11px; line-height: 12px; }
.wr-bkd[data-s="done"] .wr-bkg u { background: #fff; color: #000; }
.wr-bkp { flex: 1; height: 12px; border: 2px solid #000; background: #fff; }
.wr-bkp i { display: block; height: 100%; background: repeating-linear-gradient(90deg, #000 0 6px, #fff 6px 8px); }
.wr-bkd blockquote { margin: 2px 0 0; padding: 6px 10px; border-left: 4px solid var(--ac); background: color-mix(in srgb, var(--ac) 12%, #fff); font-size: 14px; line-height: 19px; }
.wr-bkd blockquote::before { content: "“"; margin-right: 2px; }
.wr-bkd blockquote::after { content: "”"; margin-left: 2px; }
.wr-bkd p { margin: 0; font-size: 13px; line-height: 17px; }
.wr-bkd .wr-bkq { opacity: .65; }
.wr-bkd .wr-bt { align-self: flex-start; height: 26px; font-size: 12px; }
.wr-bkh { margin: 0; font-size: 12px; opacity: .7; text-align: center; }
.wr-mpq { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 4px; max-height: 118px; overflow: auto; }
.wr-mpq button { display: flex; align-items: center; gap: 8px; width: 100%; height: 26px; padding: 0 6px; border: 2px solid #000; background: #fff; color: #000; font: 400 13px/1 var(--wr-px, "Pixelify Sans", "Silkscreen", "VT323", ui-monospace, monospace); text-align: left; cursor: pointer; }
.wr-mpq button b { flex: none; width: 18px; font-size: 11px; }
.wr-mpq button span { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.wr-mpq button:hover, .wr-mpq button[data-on] { background: #000; color: #fff; }
.wr-mod[data-k="music"] .wr-mbox { width: min(380px, 100%); }
.wr-cb, .wr-zb { touch-action: manipulation; }
.wr-cb::after, .wr-zb::after { content: ""; position: absolute; inset: -8px; }
@media (max-width: 640px), (max-height: 640px) {
    .wr-mod[data-k="os"] .wr-mbox { padding: 40px 10px 10px; }
    .wr-bzb { top: 9px; bottom: auto; left: 14px; right: 14px; }
}
@container (max-width: 480px) {
    .wr-cs button { width: 26px; height: 26px; }
    .wr-pgr { left: auto; right: 6px; bottom: 8px; transform: none; gap: 5px; padding: 3px 5px; font-size: 12px; }
    .wr-pgr .wr-bt { padding: 0 6px; }
    .wr-pgw { display: none; }
}

.wr-boot { position: absolute; inset: 0; z-index: 80; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 14px; background: color-mix(in srgb, var(--ac) 10%, #e4e4e4); animation: wr-bo .4s steps(4) 2s forwards; }
.wr-boot b { font: 400 18px/22px var(--wr-px, "Pixelify Sans", "Silkscreen", "VT323", ui-monospace, monospace); font-weight: 700; }
.wr-pb { width: 230px; height: 16px; padding: 2px; border: 2px solid #000; background: #fff; }
.wr-pb i { display: block; width: 0; height: 100%; background: #000; animation: wr-ld 1.6s steps(16) .2s forwards; }
.wr-ext { display: flex; gap: 10px; height: 28px; }
.wr-ext span { opacity: 0; animation: wr-ex .01s steps(1) forwards; }
@keyframes wr-ex { to { opacity: 1; } }
@keyframes wr-bo { to { opacity: 0; visibility: hidden; } }
.wr-am { font-size: 14px; }
.wr-amh { display: flex; align-items: center; gap: 12px; margin-bottom: 12px; }
.wr-amh div { display: flex; flex-direction: column; gap: 2px; }
.wr-amh b { font-size: 16px; }
.wr-amr { display: flex; justify-content: space-between; padding: 3px 0; border-bottom: 2px dotted #000; }
.wr-mem { height: 16px; margin: 10px 0; padding: 2px; border: 2px solid #000; }
.wr-mem i { display: block; height: 100%; background: repeating-linear-gradient(90deg, #000 0 2px, #fff 2px 3px); }
.wr-am small { opacity: .6; }
.wr-lk { display: flex; flex-direction: column; align-items: flex-start; gap: 6px; }
.wr-nt pre { margin: 8px 0 0; white-space: pre-wrap; font: 400 14px/18px var(--wr-px, "Pixelify Sans", "Silkscreen", "VT323", ui-monospace, monospace); }
.wr-im p { margin-top: 8px; }
@container (max-width: 640px) {
    .wr-w2 { left: 4px !important; top: 4px !important; width: calc(100% - 8px) !important; }
    .wr-ics { grid-auto-columns: 70px; right: 80px; }
    .wr-ic { width: 66px; }
    .wr-ic .l { max-width: 64px; }
}

/* buttons shared everywhere (Send and Copy email now match) */
.wr-bt { display: inline-flex; align-items: center; justify-content: center; box-sizing: border-box; height: 30px; padding: 0 14px; border: 2px solid #000; border-radius: 8px; cursor: pointer; color: #000; background: #fff; font: 400 14px/1 var(--wr-px, "Pixelify Sans", "Silkscreen", "VT323", ui-monospace, monospace); text-decoration: none; white-space: nowrap; }
.wr-bt:hover { color: #fff; background: #000; }
.wr-bt:active { transform: translate(1px, 1px); }
.wr-bt[data-def] { box-shadow: 0 0 0 2px #fff, 0 0 0 4px #000; margin: 4px; }
/* piano */
.wr-keys2 { touch-action: none; user-select: none; -webkit-user-select: none; -webkit-touch-callout: none; position: relative; display: flex; height: 120px; box-shadow: 0 0 0 2px #2a2438; }
.wr-wk { flex: 1; padding: 0; border: 0; border-right: 2px solid #2a2438; cursor: pointer; background: #fff; transition: background .08s steps(1); }
.wr-wk:last-of-type { border-right: 0; }
.wr-wk[data-d] { background: var(--ac); }
.wr-bk2 { position: absolute; top: 0; width: 7.2%; height: 62%; padding: 0; border: 0; cursor: pointer; background: #2a2438; z-index: 1; }
.wr-bk2[data-d] { background: var(--ac); }
/* settings + music */
.wr-sr { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 6px 10px; padding: 7px 0; border-bottom: 2px dashed rgba(42,36,56,.18); font-size: 14px; }
.wr-sr:last-child { border-bottom: 0; }

/* chatbox + resume */
.wr-ch { display: flex; flex-direction: column; gap: 10px; }
.wr-chh { display: flex; align-items: center; gap: 10px; padding-bottom: 8px; border-bottom: 2px dashed #000; }
.wr-chh .wr-avp { width: 40px; height: 40px; font-size: 16px; }
.wr-chh b { display: block; font: 400 10px/14px var(--wr-hd, "Press Start 2P", "Pixelify Sans", ui-monospace, monospace); }
.wr-chh em { display: flex; align-items: center; gap: 5px; font-style: normal; font-size: 12px; opacity: .7; }
.wr-chh em i { width: 7px; height: 7px; background: #3ccf7a; animation: wr-blink 2s steps(1) infinite; }
.wr-chl { display: flex; flex-direction: column; gap: 8px; height: 220px; max-height: 34vh; overflow: auto; padding: 8px; background: #f4f1ea repeating-linear-gradient(0deg, rgba(0,0,0,.035) 0 2px, transparent 2px 4px); box-shadow: inset 0 0 0 2px #000; overscroll-behavior: contain; }
.wr-chm { max-width: 88%; padding: 7px 9px; border: 2px solid #000; background: #fff; color: #000; font: 400 14px/18px var(--wr-px, "Pixelify Sans", "Silkscreen", "VT323", ui-monospace, monospace); box-shadow: 2px 2px 0 #000; overflow-wrap: anywhere; animation: wr-chin .18s steps(3) backwards; }
.wr-chm[data-w="me"] { align-self: flex-start; }
.wr-chm[data-w="you"] { align-self: flex-end; background: var(--ac); color: var(--acink); }
.wr-chm q { display: block; quotes: none; }
.wr-chm cite { display: block; margin-top: 7px; font: 400 8px/12px var(--wr-hd, "Press Start 2P", "Pixelify Sans", ui-monospace, monospace); font-style: normal; }
.wr-chm cite span { display: block; margin-top: 3px; font: 400 12px/14px var(--wr-px, "Pixelify Sans", "Silkscreen", "VT323", ui-monospace, monospace); opacity: .65; }
.wr-chm .wr-bt { display: flex; width: max-content; margin-top: 8px; height: 26px; font-size: 12px; }
.wr-chd { display: inline-flex; align-items: center; gap: 4px; height: 18px; }
.wr-chd i { width: 6px; height: 6px; background: #000; animation: wr-chb .9s steps(1) infinite; }
.wr-chd i:nth-child(2) { animation-delay: .15s; }
.wr-chd i:nth-child(3) { animation-delay: .3s; }
@keyframes wr-chb { 0%, 60%, 100% { transform: none; opacity: .35; } 30% { transform: translateY(-3px); opacity: 1; } }
@keyframes wr-chin { from { transform: translateY(6px); opacity: 0; } }
.wr-chq { display: flex; flex-wrap: wrap; gap: 6px; max-height: 128px; overflow: auto; padding: 0 2px 2px 0; }
.wr-chq button { padding: 5px 8px; border: 2px solid #000; background: #fff; color: #000; font: 400 13px/16px var(--wr-px, "Pixelify Sans", "Silkscreen", "VT323", ui-monospace, monospace); text-align: left; cursor: pointer; box-shadow: 2px 2px 0 #000; touch-action: manipulation; }
.wr-chq button:hover:not(:disabled) { background: #000; color: #fff; }
.wr-chq button:active:not(:disabled) { transform: translate(1px, 1px); box-shadow: 1px 1px 0 #000; }
.wr-chq button:disabled { opacity: .45; cursor: default; }
.wr-rt { display: flex; gap: 6px; margin-bottom: 10px; }
.wr-rt .wr-bt { height: 26px; padding: 0 10px; font-size: 12px; }
.wr-ra { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 12px; }
.wr-rp { padding: 14px 14px 12px; background: #fffdf6 repeating-linear-gradient(0deg, transparent 0 19px, rgba(90,160,255,.2) 19px 20px); box-shadow: inset 0 0 0 2px #000, 3px 3px 0 rgba(0,0,0,.3); }
.wr-rp h3 { margin: 0; font: 400 13px/20px var(--wr-hd, "Press Start 2P", "Pixelify Sans", ui-monospace, monospace); }
.wr-rp > em { display: block; font-style: normal; font-size: 13px; line-height: 20px; opacity: .7; }
.wr-rs h4 { margin: 14px 0 4px; padding-bottom: 2px; border-bottom: 2px solid #000; font: 400 9px/14px var(--wr-hd, "Press Start 2P", "Pixelify Sans", ui-monospace, monospace); text-transform: uppercase; }
.wr-rr { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 2px 10px; margin-top: 6px; font-size: 14px; line-height: 18px; }
.wr-rr b { font-weight: 400; }
.wr-rr span { opacity: .65; font-size: 13px; }
.wr-rs ul { margin: 2px 0 0; padding-left: 16px; font-size: 14px; line-height: 18px; }
.wr-rs p { margin: 4px 0 0; font-size: 14px; line-height: 18px; }
.wr-mod[data-k="chat"] .wr-mbox { width: min(420px, 100%); }
.wr-mod[data-k="resume"] .wr-mbox { width: min(470px, 100%); }
.wr-w2[data-k="chat"] { width: 360px; }
.wr-w2[data-k="resume"] { width: 400px; }
.wr-w2 .wr-chl { height: 190px; }
@media (prefers-reduced-motion: reduce) { .wr-chm, .wr-chd i { animation: none; } }
.wr-seg { display: flex; flex-wrap: wrap; gap: 4px; }
.wr-seg button { padding: 3px 7px; border: 0; cursor: pointer; font: 400 12px/14px var(--wr-px, "Pixelify Sans", "Silkscreen", "VT323", ui-monospace, monospace); color: #2a2438; background: #ece8f6; box-shadow: 0 0 0 2px #2a2438; }
.wr-seg button[data-on] { color: var(--acink); background: var(--ac); }
.wr-tgl { position: relative; width: 38px; height: 18px; padding: 0; border: 0; cursor: pointer; background: #cfc9df; box-shadow: 0 0 0 2px #2a2438; }
.wr-tgl i { position: absolute; left: 2px; top: 2px; width: 14px; height: 14px; background: #2a2438; transition: left .12s steps(2); }
.wr-tgl[data-on] { background: var(--ac); }
.wr-tgl[data-on] i { left: 22px; }
.wr-eq { display: flex; align-items: flex-end; gap: 4px; height: 54px; }
.wr-eq i { width: 8px; height: 6px; background: var(--ac); box-shadow: 0 0 0 2px #2a2438; }
.wr-eq[data-on] i { animation: wr-eqb .7s steps(5) infinite alternate; }
@keyframes wr-eqb { from { height: 6px; } to { height: 52px; } }
.wr-pxs { position: absolute; }
.wr-pxc { display: block; width: 100%; height: 100%; image-rendering: pixelated; image-rendering: crisp-edges; image-rendering: pixelated; touch-action: pan-y; }
.wr-kb { position: absolute; pointer-events: none; outline: none; }
.wr-kb:focus-visible { box-shadow: 0 0 0 2px var(--ac), 0 0 0 4px #fff; }
.wr-bar[data-l="top"] { left: 8px; right: 8px; top: 8px; flex-direction: row; flex-wrap: wrap; justify-content: center; gap: 6px; }
.wr-bar[data-l="top"] .wr-mood { padding: 4px 6px; font-size: 7px; gap: 4px; }
.wr-cap[data-l="top"] { left: 50%; top: auto; bottom: 58px; transform: translateX(-50%); max-width: 86%; text-align: center; }
.wr-cb { background: #fff url("data:image/svg+xml,%3Csvg%20xmlns%3D'http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg'%20viewBox%3D'0%200%205%205'%20shape-rendering%3D'crispEdges'%20fill%3D'%23000000'%3E%3Crect%20x%3D'0'%20y%3D'0'%20width%3D'1'%20height%3D'1'%2F%3E%3Crect%20x%3D'4'%20y%3D'0'%20width%3D'1'%20height%3D'1'%2F%3E%3Crect%20x%3D'1'%20y%3D'1'%20width%3D'1'%20height%3D'1'%2F%3E%3Crect%20x%3D'3'%20y%3D'1'%20width%3D'1'%20height%3D'1'%2F%3E%3Crect%20x%3D'2'%20y%3D'2'%20width%3D'1'%20height%3D'1'%2F%3E%3Crect%20x%3D'1'%20y%3D'3'%20width%3D'1'%20height%3D'1'%2F%3E%3Crect%20x%3D'3'%20y%3D'3'%20width%3D'1'%20height%3D'1'%2F%3E%3Crect%20x%3D'0'%20y%3D'4'%20width%3D'1'%20height%3D'1'%2F%3E%3Crect%20x%3D'4'%20y%3D'4'%20width%3D'1'%20height%3D'1'%2F%3E%3C%2Fsvg%3E") center / 10px 10px no-repeat; image-rendering: pixelated; }
.wr-cb:hover { background: #000 url("data:image/svg+xml,%3Csvg%20xmlns%3D'http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg'%20viewBox%3D'0%200%205%205'%20shape-rendering%3D'crispEdges'%20fill%3D'%23ffffff'%3E%3Crect%20x%3D'0'%20y%3D'0'%20width%3D'1'%20height%3D'1'%2F%3E%3Crect%20x%3D'4'%20y%3D'0'%20width%3D'1'%20height%3D'1'%2F%3E%3Crect%20x%3D'1'%20y%3D'1'%20width%3D'1'%20height%3D'1'%2F%3E%3Crect%20x%3D'3'%20y%3D'1'%20width%3D'1'%20height%3D'1'%2F%3E%3Crect%20x%3D'2'%20y%3D'2'%20width%3D'1'%20height%3D'1'%2F%3E%3Crect%20x%3D'1'%20y%3D'3'%20width%3D'1'%20height%3D'1'%2F%3E%3Crect%20x%3D'3'%20y%3D'3'%20width%3D'1'%20height%3D'1'%2F%3E%3Crect%20x%3D'0'%20y%3D'4'%20width%3D'1'%20height%3D'1'%2F%3E%3Crect%20x%3D'4'%20y%3D'4'%20width%3D'1'%20height%3D'1'%2F%3E%3C%2Fsvg%3E") center / 10px 10px no-repeat; }
.wr-zb::before { content: ""; position: absolute; right: 1px; bottom: 1px; width: 8px; height: 8px; box-sizing: border-box; border: 2px solid #000; background: #fff; }
.wr-zb::after { left: 1px; top: 1px; width: 5px; height: 5px; border: 0; background: #000; }
.wr-zb:hover { background: #000; }
.wr-zb:hover::before { background: #000; border-color: #fff; }
.wr-zb:hover::after { background: #fff; }
.wr-stt { display: flex; align-items: center; gap: 6px; margin-right: 6px; padding: 0 8px !important; font-size: 13px; line-height: 18px; white-space: nowrap; border: 2px solid #000; background: #fff; }
.wr-stt i { width: 8px; height: 8px; background: #2fd06a; box-shadow: 0 0 0 1px #000; animation: wr-blink 1.6s steps(1) infinite; }
@container (max-width: 400px) { .wr-mn .wr-mi:nth-child(3) { display: none; } .wr-mn { font-size: 13px; } .wr-mi > button { padding: 0 5px; } .wr-stt { font-size: 10px; max-width: 100px; overflow: hidden; text-overflow: ellipsis; margin-right: 2px; padding: 0 5px !important; } }
@container (max-width: 520px) { .wr-stt { font-size: 11px; padding: 0 5px !important; } .wr-mn > span:last-child { display: none; } }
.wr-pwr { display: flex; align-items: center; gap: 7px; padding: 4px 9px 4px 6px; border: 0; cursor: pointer; background: #d6cfba; box-shadow: 0 0 0 2px #3b3629, inset 0 -3px 0 rgba(0,0,0,.18), inset 0 2px 0 rgba(255,255,255,.55); color: #3b3629; }
.wr-pwr:hover { background: #ffe9a8; }
.wr-pwr:active { transform: translate(1px, 1px); }
.wr-pwr b { position: relative; width: 14px; height: 14px; border: 2px solid #3b3629; border-radius: 50%; box-sizing: border-box; border-top-color: transparent; }
.wr-pwr b::after { content: ""; position: absolute; left: 4px; top: -5px; width: 2px; height: 7px; background: #3b3629; }
.wr-pwr em { font: 400 8px/10px var(--wr-hd, "Press Start 2P", "Pixelify Sans", ui-monospace, monospace); font-style: normal; }

/* ---- v5: aquarium, small screens ---- */
.wr-aqv { display: flex; flex-direction: column; gap: 10px; }
.wr-aqc { display: block; width: 100%; aspect-ratio: 128 / 80; image-rendering: pixelated; border: 2px solid #000; box-shadow: 0 0 0 3px #8a6a44, 0 0 0 5px #000; background: #58b8d8; cursor: crosshair; touch-action: manipulation; }
.wr-aqv .wr-pvb { margin-top: 6px; }
.wr-aqv .wr-pvb .wr-bt { height: 30px; padding: 0 14px; font: 400 8px/10px var(--wr-hd, "Press Start 2P", "Pixelify Sans", ui-monospace, monospace); color: #000; background: #fff; border: 2px solid #000; }
.wr-aqv .wr-pvb .wr-bt:hover { color: #fff; background: #000; }
.wr-aqt { margin: 0; font: 400 15px/20px var(--wr-px, "Pixelify Sans", "Silkscreen", "VT323", ui-monospace, monospace); }
.wr-mod[data-k="tank"] .wr-mbox { width: min(640px, 100%); }
.wr-mbox { box-sizing: border-box; }
@media (max-width: 640px), (max-height: 640px) {
    .wr-mod { padding: 6px; }
    .wr-mod[data-k="os"] .wr-mbox { padding: 40px 10px 10px; border-radius: 16px; }
    .wr-bzb { left: 16px; right: 16px; top: 9px; bottom: auto; }
    .wr-pwr { padding: 3px 7px 3px 5px; }
    .wr-pwr em { font-size: 7px; }
}

</style><div class="wr-yth" aria-hidden="true"></div><div class="wr-zoom" style="transform: translate(0px, 0px) scale(1);"><div class="wr-pxs" style="left: 319.36px; top: 0.78px; width: 1281.28px; height: 1133.44px;"><div class="wr-kb" data-o="p_window" tabindex="0" role="button" aria-label="p_window" style="left: 344.96px; top: 172.48px; width: 579.04px; height: 354.2px; min-width: 36.96px; min-height: 36.96px;"></div><div class="wr-kb" data-o="p_monitor" tabindex="0" role="button" aria-label="p_monitor" style="left: 643.72px; top: 308px; width: 178.64px; height: 221.76px; min-width: 36.96px; min-height: 36.96px;"></div><div class="wr-kb" data-o="p_chair" tabindex="0" role="button" aria-label="p_chair" style="left: 591.36px; top: 520.52px; width: 101.64px; height: 160.16px; min-width: 36.96px; min-height: 36.96px;"></div><div class="wr-kb" data-o="p_shelf" tabindex="0" role="button" aria-label="p_shelf" style="left: 135.52px; top: 486.64px; width: 209.44px; height: 280.28px; min-width: 36.96px; min-height: 36.96px;"></div><div class="wr-kb" data-o="p_sofa" tabindex="0" role="button" aria-label="p_sofa" style="left: 899.36px; top: 566.72px; width: 252.56px; height: 221.76px; min-width: 36.96px; min-height: 36.96px;"></div><div class="wr-kb" data-o="p_table" tabindex="0" role="button" aria-label="p_table" style="left: 477.4px; top: 736.12px; width: 190.96px; height: 123.2px; min-width: 36.96px; min-height: 36.96px;"></div><div class="wr-kb" data-o="p_lamp" tabindex="0" role="button" aria-label="p_lamp" style="left: 1114.96px; top: 566.72px; width: 67.76px; height: 218.68px; min-width: 36.96px; min-height: 36.96px;"></div><div class="wr-kb" data-o="p_frame" tabindex="0" role="button" aria-label="p_frame" style="left: 1041.04px; top: 418.88px; width: 67.76px; height: 126.28px; min-width: 36.96px; min-height: 36.96px;"></div><div class="wr-kb" data-o="p_lights" tabindex="0" role="button" aria-label="p_lights" style="left: 70.84px; top: 80.08px; width: 1139.6px; height: 