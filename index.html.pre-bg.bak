.wr-mpv input::-moz-range-thumb { width: 10px; height: 18px; background: #000; border: 0; border-radius: 0; }
.wr-mpi { display: flex; gap: 6px; }
.wr-mpi input { flex: 1; min-width: 0; height: 30px; box-sizing: border-box; padding: 0 7px; border: 2px solid #000; background: #fff; color: #000; font: 400 13px/1 var(--wr-px, "Pixelify Sans", "Silkscreen", "VT323", ui-monospace, monospace); border-radius: 0; }
.wr-mpe { margin: 0; padding: 4px 6px; border: 2px solid #000; background: #ffe0e0; font-size: 12px; line-height: 15px; }
.wr-mph { margin: 0; font-size: 12px; line-height: 15px; opacity: .8; }
.wr-mpr { padding: 0; border: 0; background: none; color: inherit; font: inherit; text-decoration: underline; cursor: pointer; }
.wr-mpo { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding-top: 8px; border-top: 2px dashed #000; font-size: 12px; }
.wr-mpo .wr-bt { height: 26px; padding: 0 8px; font-size: 12px; }
.wr-yth { position: absolute; left: 0; bottom: 0; width: 1px; height: 1px; overflow: hidden; opacity: .01; pointer-events: none; }

.wr-lib { display: flex; flex-wrap: wrap; align-content: flex-start; column-gap: 3px; row-gap: 8px; padding: 12px 12px 0; min-height: 156px; max-height: 44vh; overflow: auto; box-sizing: border-box; border: 3px solid #3b2230; background: linear-gradient(#2a1d33, #3a2a44); box-shadow: inset 0 0 0 2px #c79a45, 4px 4px 0 #000; background-image: repeating-linear-gradient(to bottom, transparent 0 148px, #c79a45 148px 150px, #5a3446 150px 158px), linear-gradient(#2a1d33, #3a2a44); background-size: 100% 158px, 100% 100%; background-attachment: local; background-position: 0 12px, 0 0; }
.wr-libw { position: relative; }
.wr-bkt { align-items: center; }
.wr-bkt .wr-gr { margin-left: auto; height: 26px; padding: 0 10px; font-size: 12px; }
.wr-tr { display: flex; flex-direction: column; gap: 12px; }
.wr-trg { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; padding: 10px; background: #f4f1ea repeating-linear-gradient(0deg, rgba(0,0,0,.035) 0 2px, transparent 2px 4px); box-shadow: inset 0 0 0 2px #000; }
.wr-trg button { display: flex; flex-direction: column; align-items: center; gap: 4px; padding: 8px 4px 6px; border: 2px solid #000; background: #fff; color: #000; cursor: pointer; box-shadow: 2px 2px 0 #000; font: 400 12px/14px var(--wr-px, "Pixelify Sans", "Silkscreen", "VT323", ui-monospace, monospace); touch-action: manipulation; }
.wr-trg button span { max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.wr-trg button:hover, .wr-trg button[data-on] { background: var(--ac); color: var(--acink); transform: translateY(-2px); box-shadow: 2px 4px 0 #000; }
.wr-trd { padding: 10px 12px; border: 2px solid #000; background: #fffdf2; box-shadow: 3px 3px 0 rgba(0,0,0,.4); animation: wr-chin .18s steps(3) backwards; }
