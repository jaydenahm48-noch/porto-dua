	(function() {
	  var origGetContext = HTMLCanvasElement.prototype.getContext;
	  HTMLCanvasElement.prototype.getContext = function(type, opts) {
	    var ctx = origGetContext.call(this, type, opts);
	    if (type !== '2d' || ctx.__patched) return ctx;
	    ctx.__patched = true;
	    var self = this;
	    var origDesc = Object.getOwnPropertyDescriptor(CanvasRenderingContext2D.prototype, 'fillStyle');
	    var colors = new Set();
	    Object.defineProperty(ctx, 'fillStyle', {
	      set: function(v) {
	        if (self.width === 416 && self.height === 368) {
	          if (!colors.has(v)) { colors.add(v); }
	        }
	        origDesc.set.call(ctx, v);
	      },
	      get: function() { return origDesc.get.call(ctx); },
	      configurable: true
	    });
	    return ctx;
	  };
	})();
	</script>
