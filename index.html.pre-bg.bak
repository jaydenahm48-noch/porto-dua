<style>
  #pixel-dog {
    position: fixed;
    pointer-events: none;
    z-index: 9999;
    image-rendering: pixelated;
  }

  /* canvas pixel art selalu di atas PC */
  .wr-pxc { z-index: 2 !important; }
  #pc-img { z-index: 1 !important; }

</style>

<script>
// Fix: saat window control panel terbuka, semua klik di canvas diteruskan ke bawahnya
(function() {
  document.addEventListener('pointerdown', function(e) {
    if (!e.target || e.target.className.indexOf('wr-pxc') === -1) return;
    if (!document.querySelector('.wr-w2')) return;
    var canvas = e.target;
    canvas.style.pointerEvents = 'none';
    var under = document.elementFromPoint(e.clientX, e.clientY);
    canvas.style.pointerEvents = '';
    if (under && under !== canvas) {
      under.dispatchEvent(new PointerEvent('pointerdown', {bubbles:true,cancelable:true,clientX:e.clientX,clientY:e.clientY,pointerId:e.pointerId,pointerType:e.pointerType,button:e.button,buttons:e.buttons}));
      e.stopImmediatePropagation();
      e.preventDefault();
    }
  }, true);

  document.addEventListener('click', function(e) {
    if (!e.target || e.target.className.indexOf('wr-pxc') === -1) return;
    if (!document.querySelector('.wr-w2')) return;
    var canvas = e.target;
    canvas.style.pointerEvents = 'none';
    var under = document.elementFromPoint(e.clientX, e.clientY);
    canvas.style.pointerEvents = '';
    if (under && under !== canvas) {
      under.dispatchEvent(new MouseEvent('click', {bubbles:true,cancelable:true,clientX:e.clientX,clientY:e.clientY,button:e.button}));
      e.stopImmediatePropagation();
      e.preventDefault();
    }
  }, true);
})();
</script>

<style>
  /* Override warna accent button (HELLO dll) jadi biru */
  .wr {
    --ac: #4a90e2 !important;
  }

  /* Desktop background biru, folder kuning */
  .wr-os {
    --ac: #4a90e2 !important;
  }

  /* Folder icon → kuning via hue-rotate */
  .wr-os .wr-px {
    filter: hue-rotate(195deg) saturate(1.2) !important;
  }
</style>
	
