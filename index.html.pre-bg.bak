	<div id="main" data-framer-hydrate-v2="{&quot;routeId&quot;:&quot;augiA20Il&quot;,&quot;localeId&quot;:&quot;default&quot;,&quot;breakpoints&quot;:[{&quot;hash&quot;:&quot;72rtr7&quot;,&quot;mediaQuery&quot;:&quot;(min-width: 1200px)&quot;},{&quot;hash&quot;:&quot;1sa0boz&quot;,&quot;mediaQuery&quot;:&quot;(min-width: 810px) and (max-width: 1199.98px)&quot;},{&quot;hash&quot;:&quot;lhp0zd&quot;,&quot;mediaQuery&quot;:&quot;(max-width: 809.98px)&quot;}]}" data-framer-ssr-released-at="2026-10-19T21:45:06.812Z" data-framer-page-optimized-at="2026-10-21T05:21:25.612Z" data-framer-generated-page=""><!--$--><style data-framer-html-style="">html body { background: rgb(239, 233, 255); }</style><div data-framer-root="" class="framer-tSpxR framer-72rtr7" style="min-height:100vh;width:auto"><div class="framer-1fx4p2d-container"><div class="wr" data-room="pastel" style="height: 100%; width: 100%; background: #121020; filter: invert(90%) hue-rotate(180deg) brightness(85%) contrast(120%); --ac: #ffff00; --acink: #05040a; --wr-px: &quot;Pixelify Sans&quot;, ui-monospace, monospace; --wr-hd: &quot;Press Start 2P&quot;, ui-monospace, monospace;"><style>@import url("https://fonts.googleapis.com/css2?family=Pixelify+Sans:wght@400;600&family=Press+Start+2P&display=swap");</style><style>
.wr { position: relative; width: 100%; aspect-ratio: 640 / 560; overflow: hidden; container-type: inline-size; user-select: none; -webkit-user-select: none; touch-action: pan-y; font-family: var(--wr-px, "Pixelify Sans", "Silkscreen", "VT323", ui-monospace, monospace); -webkit-tap-highlight-color: transparent; }

/* ui */
@keyframes wr-blink { 50% { opacity: 0; } }
.wr-cap { position: absolute; left: 10px; top: 10px; z-index: 3; max-width: 60%; padding: 4px 7px; font-size: 12px; line-height: 14px; color: #2a2438; background: rgba(255,255,255,.85); box-shadow: 0 0 0 2px #2a2438, 3px 3px 0 2px rgba(42,36,56,.25); pointer-events: none; animation: wr-in .3s steps(4) backwards; }
.wr-mood { display: flex; align-items: center; gap: 6px; padding: 5px 8px; border: 0; cursor: pointer; font: 400 8px/10px var(--wr-hd, "Press Start 2P", "Pixelify Sans", ui-monospace, monospace); color: #2a2438; background: #fff; box-shadow: 0 0 0 2px #2a2438, 3px 3px 0 2px rgba(42,36,56,.25); }
.wr-mood:active { transform: translate(1px,1px); }
.wr-mood i { width: 10px; height: 10px; border-radius: 50%; background: #ffb340; box-shadow: 0 0 0 2px #2a2438; }
.wr-mood i[data-m="night"] { background: #5b6cff; }
.wr-mood i[data-m="day"] { background: #ffe066; }
.wr-tip { position: absolute; left: 0; top: 0; z-index: 4; width: 210px; max-width: calc(100% - 12px); padding: 8px 10px 9px; color: #2a2438; background: #fff; box-shadow: 0 0 0 2px #2a2438, 4px 4px 0 2px rgba(42,36,56,.28); opacity: 0; pointer-events: none; transition: opacity .12s steps(2); }
.wr-tip[data-on] { opacity: 1; pointer-events: auto; animation: wr-in .22s steps(4) backwards; }
@keyframes wr-in { from { opacity: 0; margin-top: 6px; } }
.wr-th { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 5px; }
.wr-th b { font: 400 9px/12px var(--wr-hd, "Press Start 2P", "Pixelify Sans", ui-monospace, monospace); color: #2a2438; padding-left: 10px; background: linear-gradient(var(--ac), var(--ac)) 0 50% / 6px 6px no-repeat; }
.wr-th button { position: relative; flex: none; width: 16px; height: 16px; padding: 0; border: 0; cursor: pointer; font-size: 0; background: #2a2438 url("data:image/svg+xml,%3Csvg%20xmlns%3D'http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg'%20viewBox%3D'0%200%205%205'%20shape-rendering%3D'crispEdges'%20fill%3D'%23ffffff'%3E%3Crect%20x%3D'0'%20y%3D'0'%20width%3D'1'%20height%3D'1'%2F%3E%3Crect%20x%3D'4'%20y%3D'0'%20width%3D'1'%20height%3D'1'%2F%3E%3Crect%20x%3D'1'%20y%3D'1'%20width%3D'1'%20height%3D'1'%2F%3E%3Crect%20x%3D'3'%20y%3D'1'%20width%3D'1'%20height%3D'1'%2F%3E%3Crect%20x%3D'2'%20y%3D'2'%20width%3D'1'%20height%3D'1'%2F%3E%3Crect%20x%3D'1'%20y%3D'3'%20width%3D'1'%20height%3D'1'%2F%3E%3Crect%20x%3D'3'%20y%3D'3'%20width%3D'1'%20height%3D'1'%2F%3E%3Crect%20x%3D'0'%20y%3D'4'%20width%3D'1'%20height%3D'1'%2F%3E%3Crect%20x%3D'4'%20y%3D'4'%20width%3D'1'%20height%3D'1'%2F%3E%3C%2Fsvg%3E") center / 10px 10px no-repeat; image-rendering: pixelated; touch-action: manipulation; }
.wr-th button:hover { background-color: var(--ac); }
.wr-th button::after { content: ""; position: absolute; inset: -8px; }
.wr-tip p { margin: 0; font-size: 13px; line-height: 16px; }
.wr-tg { display: flex; flex-wrap: wrap; gap: 4px; margin-top: 7px; }
.wr-tg span { padding: 1px 5px; font-size: 11px; line-height: 14px; color: var(--acink); background: var(--ac); }
.wr-ln2 { display: inline-block; margin-top: 8px; padding: 4px 8px; font: 400 8px/10px var(--wr-hd, "Press Start 2P", "Pixelify Sans", ui-monospace, monospace); color: #fff; background: #2a2438; text-decoration: none; }
.wr-ln2:hover { background: var(--ac); color: var(--acink); }
.wr-chips { position: absolute; left: 8px; right: 8px; bottom: 8px; z-index: 3; display: flex; gap: 5px; overflow-x: auto; padding: 3px 3px 6px; scrollbar-width: none; }
.wr-chips::-webkit-scrollbar { display: none; }
.wr-chips button { flex: none; padding: 4px 8px; border: 0; cursor: pointer; font: 400 12px/14px var(--wr-px, "Pixelify Sans", "Silkscreen", "VT323", ui-monospace, monospace); color: #2a2438; background: rgba(255,255,255,.9); box-shadow: 0 0 0 2px #2a2438; transition: transform .12s steps(2); }
.wr-chips button:hover { transform: translateY(-2px); }
.wr-chips button[data-on] { color: var(--acink); background: var(--ac); }
@media (prefers-reduced-motion: reduce) { .wr *, .wr *::before, .wr *::after { animation: none !important; transition: none !important; } }

@keyframes wr-bt { 50% { filter: brightness(.82); } }

/* fx layer, specks, toolbar */
.wr-fxl { position: absolute; inset: 0; z-index: 5; pointer-events: none; overflow: hidden; }
.wr-pt { position: absolute; font: 400 14px/1 var(--wr-px, "Pixelify Sans", "Silkscreen", "VT323", ui-monospace, monospace); text-shadow: 1px 0 #2a2438, -1px 0 #2a2438, 0 1px #2a2438, 0 -1px #2a2438; transform: translate(-50%,-50%); animation: wr-pt 1s steps(10) forwards; }
@keyframes wr-pt { to { transform: translate(calc(-50% + var(--dx)), calc(-50% - 46px)); opacity: 0; } }
.wr-amb { position: absolute; inset: 0; z-index: 2; pointer-events: none; overflow: hidden; }
.wr-amb i { position: absolute; width: 3px; height: 3px; background: #fff; opacity: 0; animation: wr-spk 7s linear infinite; }
.wr-amb[data-m="sunset"] i { background: #fff0d0; }
.wr-amb[data-m="night"] i { background: #ffe98a; box-shadow: 0 0 6px 2px rgba(255,233,138,.7); }
@keyframes wr-spk { 0% { opacity: 0; transform: translate(0,0); } 20%, 80% { opacity: .85; } 100% { opacity: 0; transform: translate(18px,-26px); } }
.wr-amb[data-snow] i { background: #fff; box-shadow: none; animation-name: wr-snw; }
@keyframes wr-snw { 0% { opacity: 0; transform: translate(0,-24px); } 20%, 80% { opacity: .9; } 100% { opacity: 0; transform: translate(-10px,40px); } }
.wr-bar { position: absolute; right: 10px; top: 10px; z-index: 3; display: flex; flex-direction: column; align-items: flex-end; gap: 7px; }
.wr-mood i { flex: none; }

/* ---- v3: roomfolio ---- */
.wr-zoom { position: absolute; inset: 0; transform-origin: 0 0; transition: transform .7s cubic-bezier(.22,.8,.2,1); }
.wr-cta { margin-top: 7px; font: 400 8px/10px var(--wr-hd, "Press Start 2P", "Pixelify Sans", ui-monospace, monospace); color: var(--ac); filter: brightness(.7); }
.wr-mood i[data-eq] { background: var(--ac); animation: wr-bt 0.5s steps(2) infinite; }
.wr-nav { position: absolute; left: 50%; bottom: 10px; z-index: 3; display: flex; gap: 8px; transform: translateX(-50%); }
.wr-nav button { padding: 7px 12px; border: 0; cursor: pointer; font: 400 9px/11px var(--wr-hd, "Press Start 2P", "Pixelify Sans", ui-monospace, monospace); color: #2a2438; background: #fff; box-shadow: 0 0 0 2px #2a2438, 3px 3px 0 2px rgba(42,36,56,.25); transition: transform .12s steps(2); }
.wr-nav button:hover { transform: translateY(-2px); color: var(--acink); background: var(--ac); }

.wr-intro { position: absolute; inset: 0; z-index: 30; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 14px; padding: 20px; text-align: center; color: #fff; background: color-mix(in srgb, var(--ac) 22%, #1d1830); }
.wr-intro b { font: 400 16px/22px var(--wr-hd, "Press Start 2P", "Pixelify Sans", ui-monospace, monospace); text-shadow: 3px 3px 0 #2a2438; }
.wr-intro em { font: 400 15px/18px var(--wr-px, "Pixelify Sans", "Silkscreen", "VT323", ui-monospace, monospace); font-style: normal; opacity: .85; }
.wr-intro small { font: 400 12px/14px var(--wr-px, "Pixelify Sans", "Silkscreen", "VT323", ui-monospace, monospace); opacity: .6; }
.wr-intro button { padding: 9px 14px; border: 0; cursor: pointer; font: 400 10px/12px var(--wr-hd, "Press Start 2P", "Pixelify Sans", ui-monospace, monospace); color: var(--acink); background: var(--ac); box-shadow: 0 0 0 2px #fff, 4px 4px 0 2px rgba(0,0,0,.4); }
.wr-intro button:disabled { opacity: .5; cursor: default; }
.wr-intro[data-out] { animation: wr-out .5s steps(5) forwards; pointer-events: none; }
@keyframes wr-out { to { opacity: 0; transform: scale(1.06); } }
.wr-bar2 { width: min(260px, 70%); height: 14px; padding: 2px; border: 2px solid #fff; }
.wr-bar2 i { display: block; width: 0; height: 100%; background: var(--ac); animation: wr-ld 1.2s steps(12) forwards; }
@keyframes wr-ld { to { width: 100%; } }

/* modal */
.wr-mod { position: fixed; inset: 0; z-index: 2147483000; display: flex; align-items: center; justify-content: center; padding: 16px; font-family: var(--wr-px, "Pixelify Sans", "Silkscreen", "VT323", ui-monospace, monospace); color: #2a2438; background: rgba(18,12,36,.58); animation: wr-mi .25s steps(4) backwards; }
@keyframes wr-mi { from { opacity: 0; } }
.wr-mbox { position: relative; display: flex; flex-direction: column; width: min(520px, 100%); max-height: 100%; outline: none; background: #fff; border: 2px solid #000; box-shadow: 5px 5px 0 rgba(0,0,0,.55); animation: wr-mp .3s steps(5) backwards; }
@keyframes wr-mp { from { transform: translateY(14px) scale(.96); } }
.wr-mb { padding: 16px; overflow: auto; font: 400 15px/20px var(--wr-px, "Pixelify Sans", "Silkscreen", "VT323", ui-monospace, monospace); color: #000; }
.wr-mb .wr-tg span, .wr-wb .wr-tg span { color: #000; background: #fff; box-shadow: inset 0 0 0 2px #000; }
.wr-mod[data-k="os"] .wr-mbox { width: min(1000px, 100%); height: min(700px, 100%); padding: 20px 20px 40px; border: 0; border-radius: 22px; background: linear-gradient(#e6e0cf, #cfc8b4); box-shadow: inset 0 0 0 3px #f4efe0, inset 0 -6px 0 rgba(0,0,0,.12), 0 0 0 3px #3b3629, 10px 10px 0 3px rgba(0,0,0,.4); }
.wr-bz { position: relative; flex: 1; min-height: 0; display: flex; }
.wr-bzb { position: absolute; left: 28px; right: 28px; bottom: 11px; display: flex; align-items: center; justify-content: space-between; color: #5b5545; font: 400 10px/12px var(--wr-hd, "Press Start 2P", "Pixelify Sans", ui-monospace, monospace); }
.wr-bzb i { width: 8px; height: 8px; background: #7fe0b0; box-shadow: 0 0 6px #7fe0b0; animation: wr-blink 2s steps(1) infinite; }
.wr-bz .wr-os { border-radius: 14px; box-shadow: 0 0 0 4px #2b2619, inset 0 0 0 2px #000; }

/* shared content */
.wr-pv h3, .wr-av h3, .wr-ml h3 { margin: 12px 0 6px; font: 400 12px/18px var(--wr-hd, "Press Start 2P", "Pixelify Sans", ui-monospace, monospace); }
.wr-pv p, .wr-av p { margin: 0 0 10px; font-size: 15px; line-height: 20px; }
.wr-pvi { position: relative; display: grid; place-items: center; height: 150px; background-size: cover; background-position: center; box-shadow: 0 0 0 2px #2a2438; }
.wr-pvi span { font: 400 26px var(--wr-hd, "Press Start 2P", "Pixelify Sans", ui-monospace, monospace); color: rgba(255,255,255,.9); text-shadow: 3px 3px 0 rgba(0,0,0,.3); }
.wr-pvb { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; margin-top: 12px; }
.wr-pvb button, .button-like { padding: 5px 9px; border: 0; cursor: pointer; font: 400 8px/10px var(--wr-hd, "Press Start 2P", "Pixelify Sans", ui-monospace, monospace); color: #fff; background: #2a2438; }
.wr-pvb em, .wr-av em { font-style: normal; font-size: 13px; opacity: .65; }
.wr-ln2 { border: 0; cursor: pointer; }
.wr-so { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 14px; }
.wr-avh { display: flex; align-items: center; gap: 12px; }
.wr-avh h3 { margin: 0 0 4px; }
.wr-avp { flex: none; display: grid; place-items: center; width: 64px; height: 64px; background: var(--ac) center / cover; color: var(--acink); font: 400 24px var(--wr-hd, "Press Start 2P", "Pixelify Sans", ui-monospace, monospace); box-shadow: 0 0 0 2px #2a2438, 3px 3px 0 2px rgba(0,0,0,.25); }
.wr-avh + p { margin-top: 12px; }
.wr-av ul { margin: 0; padding-left: 18px; font-size: 14px; line-height: 19px; }
.wr-av li { margin-bottom: 5px; }
.wr-ml label { display: block; margin-top: 8px; font: 400 8px/10px var(--wr-hd, "Press Start 2P", "Pixelify Sans", ui-monospace, monospace); }
.wr-ml input, .wr-ml textarea { display: block; width: 100%; margin-top: 4px; padding: 5px 7px; font: 400 14px/18px var(--wr-px, "Pixelify Sans", "Silkscreen", "VT323", ui-monospace, monospace); color: #2a2438; background: #f6f3fb; border: 0; box-shadow: inset 0 0 0 2px #2a2438; box-sizing: border-box; resize: vertical; }
.wr-ml input:focus, .wr-ml textarea:focus { outline: 2px solid var(--ac); }

/* OS (classic mac) */
.wr-os { position: relative; flex: 1; min-width: 0; overflow: hidden; border-radius: 12px; color: #000; font: 400 14px/16px var(--wr-px, "Pixelify Sans", "Silkscreen", "VT323", ui-monospace, monospace); container-type: inline-size; user-select: none; transform-origin: 50% 50%; background: repeating-conic-gradient(color-mix(in srgb, var(--ac) 38%, #fff) 0 25%, color-mix(in srgb, var(--ac) 62%, #fff) 0 50%) 0 0 / 4px 4px; }
.wr-os::after { content: ""; position: absolute; inset: 0; z-index: 90; pointer-events: none; border-radius: 12px; background: repeating-linear-gradient(0deg, rgba(0,0,0,.07) 0 1px, transparent 1px 3px); box-shadow: inset 0 0 60px rgba(0,0,0,.3); }
.wr-os[data-s="on"] { animation: wr-crton .9s steps(12) backwards; }
.wr-os[data-s="off"] { animation: wr-croff .8s steps(10) forwards; }
@keyframes wr-crton { 0% { transform: scale(.2,.005); filter: brightness(6); } 35% { transform: scale(1,.005); filter: brightness(5); } 65% { transform: scale(1,1.03); filter: brightness(1.8); } 100% { transform: none; filter: none; } }
@keyframes wr-croff { 0% { transform: none; filter: none; } 40% { transform: scale(1,.01); filter: brightness(4); } 75% { transform: scale(.02,.01); filter: brightness(8); } 100% { transform: scale(0,0); opacity: 0; } }
.wr-mn { position: absolute; left: 0; right: 0; top: 0; z-index: 70; display: flex; align-items: center; height: 26px; padding: 0 4px; background: #fff; border-bottom: 2px solid #000; font: 400 15px/22px var(--wr-px, "Pixelify Sans", "Silkscreen", "VT323", ui-monospace, monospace); }
.wr-mn .sp { flex: 1; }
.wr-mn > span { padding: 0 8px; }
.wr-mi { position: relative; }
.wr-mi > button { display: block; height: 24px; padding: 0 9px; border: 0; cursor: pointer; color: #000; background: transparent; font: inherit; }
.wr-mi > button[data-on], .wr-mi > button:hover { color: #fff; background: #000; }
.wr-mi > button[data-on] .wr-px, .wr-mi > button:hover .wr-px { filter: invert(1); }
.wr-mi .wr-px { margin: 3px 0; }
.wr-mbk { position: absolute; inset: 0; z-index: 65; }
.wr-menu { position: absolute; left: 0; top: 24px; z-index: 75; min-width: 240px; white-space: nowrap; padding: 2px 0; background: #fff; border: 2px solid #000; box-shadow: 3px 3px 0 #000; }
.wr-menu button { display: block; width: 100%; padding: 2px 16px; border: 0; cursor: pointer; text-align: left; color: #000; background: none; font: 400 14px/18px var(--wr-px, "Pixelify Sans", "Silkscreen", "VT323", ui-monospace, monospace); }
.wr-menu button:hover:not(:disabled) { color: #fff; background: #000; }
.wr-menu button:disabled { color: #999; cursor: default; }
.wr-menu hr { margin: 3px 0; border: 0; border-top: 2px dotted #000; }
.wr-desk { position: absolute; inset: 26px 0 0 0; }
.wr-ics { position: absolute; left: 10px; top: 10px; bottom: 50px; right: 110px; display: grid; grid-template-rows: repeat(auto-fill, 78px); grid-auto-flow: column; grid-auto-columns: 88px; align-content: start; pointer-events: none; }
.wr-ic { pointer-events: auto; display: flex; flex-direction: column; align-items: center; gap: 3px; width: 84px; padding: 0; border: 0; cursor: pointer; color: #000; background: none; }
.wr-ic .l { max-width: 92px; padding: 0 3px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; background: #fff; font: 400 13px/15px var(--wr-px, "Pixelify Sans", "Silkscreen", "VT323", ui-monospace, monospace); }
.wr-ic:hover .l, .wr-ic:focus-visible .l { color: #fff; background: #000; }
.wr-ic:active .wr-px { filter: invert(1); }
.wr-px { display: block; flex: none; background-size: 100% 100%; background-repeat: no-repeat; image-rendering: pixelated; }
.wr-hdk { position: absolute; right: 10px; top: 10px; }
.wr-trs { position: absolute; right: 10px; bottom: 46px; }
.wr-w2 { position: absolute; display: flex; flex-direction: column; width: 400px; max-width: calc(100% - 8px); max-height: calc(100% - 8px); background: #fff; border: 2px solid #000; box-shadow: 3px 3px 0 #000; animation: wr-mp .2s steps(3) backwards; }
.wr-w2[data-k="finder"] { width: 440px; }
.wr-w2[data-k="piano"] { width: 430px; }
.wr-w2[data-k="music"] { width: 290px; }
.wr-w2[data-k="trash"] { width: 270px; }
.wr-w2[data-k="aboutmac"] { width: 400px; }
.wr-wt { position: relative; display: flex; align-items: center; justify-content: center; flex: none; height: 24px; padding: 0 26px; cursor: grab; touch-action: none; background: #fff; border-bottom: 2px solid #000; }
.wr-wt:active { cursor: grabbing; }
.wr-w2[data-act] .wr-wt, .wr-wt[data-act] { background: repeating-linear-gradient(0deg, color-mix(in srgb, var(--ac) 55%, #000) 0 2px, #fff 2px 4px); }
.wr-wt b { position: relative; padding: 0 9px; background: #fff; font: 400 14px/20px var(--wr-px, "Pixelify Sans", "Silkscreen", "VT323", ui-monospace, monospace); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 100%; }
.wr-cb, .wr-zb { position: absolute; top: 4px; width: 16px; height: 16px; padding: 0; border: 2px solid #000; border-radius: 0; background: #fff; cursor: pointer; box-sizing: border-box; }
.wr-cb { left: 6px; }
.wr-zb { right: 6px; }
.wr-zb::after { content: ""; position: absolute; left: 2px; top: 2px; width: 5px; height: 5px; border: 1px solid #000; }
.wr-wb { flex: 1; min-height: 0; overflow: auto; padding: 12px; font: 400 14px/18px var(--wr-px, "Pixelify Sans", "Silkscreen", "VT323", ui-monospace, monospace); color: #000; user-select: text; }
.wr-wb p { margin: 0; }
.wr-wb::-webkit-scrollbar, .wr-mb::-webkit-scrollbar { width: 15px; height: 15px; }
.wr-wb::-webkit-scrollbar-track, .wr-mb::-webkit-scrollbar-track { background: repeating-conic-gradient(#000 0 25%, #fff 0 50%) 0 0 / 2px 2px; border-left: 2px solid #000; }
.wr-wb::-webkit-scrollbar-thumb, .wr-mb::-webkit-scrollbar-thumb { background: #fff; border: 2px solid #000; }
.wr-rz { position: absolute; right: 0; bottom: 0; width: 15px; height: 15px; cursor: nwse-resize; touch-action: none; background: linear-gradient(135deg, transparent 45%, #000 45% 55%, transparent 55% 70%, #000 70% 80%, transparent 80%); }
.wr-fh { display: flex; align-items: center; gap: 10px; padding-bottom: 8px; margin-bottom: 10px; border-bottom: 2px solid #000; font-size: 13px; }
.wr-fh em { flex: 1; text-align: right; font-style: normal; opacity: .65; }
.wr-fg { display: grid; grid-template-columns: repeat(auto-fill, minmax(84px, 1fr)); gap: 12px 4px; }
.wr-emp { padding: 14px 0; text-align: center; opacity: .6; }
.wr-cs { position: absolute; left: 8px; bottom: 8px; z-index: 60; display: flex; gap: 2px; padding: 3px; background: #fff; border: 2px solid #000; box-shadow: 2px 2px 0 #000; }
.wr-cs button { display: grid; place-items: center; width: 28px; height: 28px; padding: 0; border: 0; cursor: pointer; background: none; }
.wr-cs button:hover { background: #000; }
